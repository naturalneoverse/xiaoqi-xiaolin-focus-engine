[
  {
    "copyKey": "oneSelf",
    "lineIndex": 1,
    "text": "行事多顺着内心所向，少有勉强与纠结。"
  },
  {
    "copyKey": "oneSelf",
    "lineIndex": 2,
    "text": "所作所为贴近本心，活得自在又真切。"
  },
  {
    "copyKey": "oneSelf",
    "lineIndex": 3,
    "text": "循着心底想法前行，不必刻意迎合外物。"
  },
  {
    "copyKey": "oneSelf",
    "lineIndex": 4,
    "text": "守住自己的节奏，安稳度过朝夕日常。"
  },
  {
    "copyKey": "oneSelf",
    "lineIndex": 5,
    "text": "凡事随心而行，减少无谓内耗。"
  },
  {
    "copyKey": "oneSelf",
    "lineIndex": 6,
    "text": "忠于本心度日，平凡日子也满是安然。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 1,
    "text": "默默沉淀蓄力，在细碎时光里慢慢丰盈自己。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 2,
    "text": "静心积攒力量，从容等待慢慢蜕变成长。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 3,
    "text": "朝着长远方向稳步走，悄悄筑牢自身底气。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 4,
    "text": "沉心做好眼前事，一点一滴丰盈内心。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 5,
    "text": "不慌不忙向前走，安然沉淀静待向好。"
  },
  {
    "copyKey": "depthSlow",
    "lineIndex": 6,
    "text": "静心修己度日，慢慢沉淀遇见更好自己。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 1,
    "text": "心怀目标笃定前行，事上磨砺锤炼心性。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 2,
    "text": "直面当下诸事重任，历练之中沉淀底气。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 3,
    "text": "心有远志步履坚定，迎难而上稳步精进。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 4,
    "text": "立足当下全力以赴，奔赴心中既定方向。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 5,
    "text": "于繁忙中守定本心，在历练中愈发通透。"
  },
  {
    "copyKey": "depthFast",
    "lineIndex": 6,
    "text": "顺势而为全力笃行，攻坚克难自成格局。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 1,
    "text": "心怀温柔待人，日常处处满是暖意。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 2,
    "text": "待人常怀善意，生活多了几分柔软。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 3,
    "text": "以赤诚之心相处，相伴皆是舒心。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 4,
    "text": "真心对待身边人，内心满是平和温暖。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 5,
    "text": "以善意奔赴相逢，在相处中修得从容。"
  },
  {
    "copyKey": "connection",
    "lineIndex": 6,
    "text": "心存柔软善待周遭，烟火日常皆有温情。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 1,
    "text": "恪守自身本分职责，在身份历练中沉淀心性。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 2,
    "text": "肩负分内使命前行，于日常履职中丰盈阅历。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 3,
    "text": "接纳身份赋予责任，从容做好分内诸事修行。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 4,
    "text": "秉持本分踏实前行，在入世历练中成熟通透。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 5,
    "text": "顺应身份所求行事，稳步修炼处世格局。"
  },
  {
    "copyKey": "roleDuty",
    "lineIndex": 6,
    "text": "尽心承担角色使命，岁月沉淀自有成长力量。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 1,
    "text": "放缓前行脚步，安然接纳当下所有状态。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 2,
    "text": "褪去心头浮躁，稳住心绪从容度日。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 3,
    "text": "厘清繁杂琐事，稳住节奏沉淀内心。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 4,
    "text": "抛开无谓纷扰，让心神慢慢归于平和。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 5,
    "text": "少被琐事牵动情绪，安稳安顿自身心境。"
  },
  {
    "copyKey": "calmBusy",
    "lineIndex": 6,
    "text": "梳理匆忙日常，慢慢找回从容姿态。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 1,
    "text": "不必急于奔赴前路，静享当下安然时光。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 2,
    "text": "允许生活慢下来，随心度日自在舒心。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 3,
    "text": "看淡闲散日常，安然享受平淡光景。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 4,
    "text": "放下心中执念，顺其自然安然度日。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 5,
    "text": "闲来修身养心，从容感受人间日常。"
  },
  {
    "copyKey": "calmEasy",
    "lineIndex": 6,
    "text": "日子自有节奏，悠然度日亦是圆满。"
  }
]