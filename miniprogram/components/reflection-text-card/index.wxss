.reflection-text-card {
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 40rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.card-q {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.textarea-wrap {
  position: relative;
  padding-bottom: 88rpx;
  box-sizing: border-box;
}

.card-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f9fb;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #184061;
  line-height: 1.6;
}

.card-placeholder {
  color: #8a9cb0;
  font-size: 26rpx;
}

.limit-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
}

.limit-tip-corner {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  color: #8a9cb0;
  pointer-events: none;
}

.speech-mic-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.speech-mic-hit {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  background: transparent;
  border: none;
  box-shadow: none;
}

.speech-mic-hit-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.speech-layer-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.speech-mic-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  box-sizing: border-box;
}

.speech-mic-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 16rpx;
  height: 22rpx;
  margin-left: -8rpx;
  border-radius: 10rpx;
  background: #12598f;
}

.speech-mic-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 24rpx;
  height: 12rpx;
  margin-left: -12rpx;
  border: 3rpx solid #12598f;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.speech-mic-icon,
.speech-wave {
  pointer-events: none;
}

.speech-wave {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: absolute;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.speech-wave-bar {
  width: 4rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #6c92b1;
  animation: speech-wave-pulse 0.9s ease-in-out infinite;
}

@keyframes speech-wave-pulse {
  0%,
  100% {
    height: 10rpx;
    opacity: 0.45;
  }
  50% {
    height: 32rpx;
    opacity: 1;
  }
}
