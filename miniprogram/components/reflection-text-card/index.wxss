@import "../../styles/reflection-speech-mic.wxss";

.reflection-text-card {
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 40rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.card-q {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.textarea-wrap {
  position: relative;
  padding-bottom: 88rpx;
  box-sizing: border-box;
}

.card-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f7f9fb;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #184061;
  line-height: 1.6;
}

.card-placeholder {
  color: #8a9cb0;
  font-size: 26rpx;
}

.limit-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
}

.limit-tip-corner {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  color: #8a9cb0;
  pointer-events: none;
}
