:host {
  display: inline-block;
  max-width: 525rpx;
}

:host(.host-report) {
  display: block;
  width: 100%;
  max-width: none;
}

.chat-bubble {
  position: relative;
  width: auto;
  max-width: 525rpx;
  min-height: 116rpx;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--bubble-border);
  border-radius: 999rpx;
  background: #ffffff;
}

.chat-bubble::before {
  content: "";
  position: absolute;
  top: 12rpx;
  width: 56rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
}

.chat-bubble.arrow-left::before {
  left: 22rpx;
  transform: rotate(-14deg);
}

.chat-bubble.arrow-right::before {
  right: 22rpx;
  transform: rotate(14deg);
}

.chat-bubble::after {
  content: "";
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #ffffff;
}

.chat-bubble.arrow-left::after {
  left: -10rpx;
  bottom: 24rpx;
  border-left: 3rpx solid var(--bubble-border);
  border-bottom: 3rpx solid var(--bubble-border);
  border-radius: 0 0 0 14rpx;
  transform: rotate(34deg);
}

.chat-bubble.arrow-right::after {
  right: -10rpx;
  bottom: 24rpx;
  border-right: 3rpx solid var(--bubble-border);
  border-bottom: 3rpx solid var(--bubble-border);
  border-radius: 0 0 14rpx 0;
  transform: rotate(-34deg);
}

.bubble-text {
  display: block;
  color: #184061;
  font-size: 30rpx;
  line-height: 1.55;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.chat-bubble--lg {
  width: 100%;
  box-sizing: border-box;
  min-height: 128rpx;
  padding: 36rpx 32rpx 32rpx 44rpx;
  max-width: 100%;
  border-radius: 44rpx;
  overflow: visible;
}

.chat-bubble--lg .bubble-text {
  font-size: 32rpx;
  line-height: 1.58;
}

/* 时间编织报告：气泡撑满左侧区域（恢复视觉大小） */
.chat-bubble--report-shell {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  padding: 30rpx 34rpx 26rpx;
  min-height: 116rpx;
}

/* 按标点分行：居中、行距紧凑 */
.bubble-text-report-block {
  display: block;
  text-align: center;
  line-height: 1.38;
  word-break: keep-all;
  overflow-wrap: normal;
}

.bubble-text-report-line {
  margin-top: 4rpx;
}

/* 庆祝弹窗：去掉顶部高光，尾巴指向左侧小麒（垂直居中） */
.chat-bubble--lg::before {
  display: none;
}

.chat-bubble--lg.arrow-left::after {
  left: -11rpx;
  top: 50%;
  bottom: auto;
  margin-top: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 0 0 0 12rpx;
}
