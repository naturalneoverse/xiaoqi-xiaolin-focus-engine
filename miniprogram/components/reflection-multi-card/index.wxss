.reflection-multi-card {
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 40rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.card-q {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.option-block {
  margin-bottom: 16rpx;
}

.option-block:last-child {
  margin-bottom: 0;
}

.option {
  border: 2rpx solid #e1e5ea;
  border-radius: 24rpx;
  padding: 24rpx;
  min-height: 88rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 0.15s ease;
}

.option-hover {
  transform: scale(0.98);
}

.check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c5d0db;
  flex-shrink: 0;
  margin-top: 4rpx;
  box-sizing: border-box;
}

.check-square {
  border-radius: 8rpx;
}

.check-selected {
  border-color: transparent;
  background: var(--accent, #c0713b);
  position: relative;
}

.check-selected::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 45%;
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: translate(-50%, -50%) rotate(45deg);
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #184061;
  line-height: 1.6;
}

.option-with-expand {
  border-radius: 24rpx 24rpx 0 0 !important;
  margin-bottom: 0 !important;
}

.expand-card {
  margin-top: 0;
  margin-bottom: 0;
  padding: 24rpx;
  background: #f7f9fb;
  border-radius: 0 0 20rpx 20rpx;
  box-sizing: border-box;
}

.expand-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #184061;
  margin-bottom: 12rpx;
}

.expand-input-wrap {
  position: relative;
  padding-bottom: 72rpx;
  box-sizing: border-box;
}

.expand-multiline {
  padding-bottom: 88rpx;
}

.expand-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #184061;
  line-height: 1.6;
}

.expand-input {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #184061;
}

.expand-placeholder {
  color: #8a9cb0;
  font-size: 26rpx;
}

.limit-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
}

.limit-tip {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  color: #8a9cb0;
}

.speech-mic-hit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 72rpx;
  height: 72rpx;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  background: transparent;
  border: none;
  box-shadow: none;
}

.speech-mic-hit-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.speech-layer-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.speech-mic-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  box-sizing: border-box;
}

.speech-mic-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 16rpx;
  height: 22rpx;
  margin-left: -8rpx;
  border-radius: 10rpx;
  background: var(--accent, #c0713b);
}

.speech-mic-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 24rpx;
  height: 12rpx;
  margin-left: -12rpx;
  border: 3rpx solid var(--accent, #c0713b);
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.speech-wave {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: absolute;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.speech-wave-bar {
  width: 4rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: var(--accent, #c0713b);
  animation: multi-speech-wave 0.9s ease-in-out infinite;
}

@keyframes multi-speech-wave {
  0%,
  100% {
    height: 10rpx;
    opacity: 0.45;
  }
  50% {
    height: 32rpx;
    opacity: 1;
  }
}
