.cal {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(18, 89, 143, 0.08);
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.cal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #184a72;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef5fc;
}

.cal-nav-hover {
  opacity: 0.75;
}

.cal-nav-icon {
  font-size: 44rpx;
  line-height: 1;
  color: #12598f;
  font-weight: 600;
}

.cal-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
}

.cal-weekday {
  text-align: center;
  font-size: 24rpx;
  color: #8ea8c8;
  font-weight: 600;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 12rpx;
}

.cal-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
}

.cal-cell--pad {
  pointer-events: none;
}

.cal-day {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid transparent;
}

.cal-day--plain .cal-day-num {
  color: #b8c5d4;
  font-weight: 500;
}

.cal-day--checked {
  border-color: #12598f;
  background: rgba(18, 89, 143, 0.06);
}

.cal-day--checked .cal-day-num {
  color: #12598f;
  font-weight: 700;
}

.cal-day--today {
  background: rgba(24, 74, 114, 0.12);
  box-shadow: 0 0 0 2rpx rgba(24, 74, 114, 0.25);
}

.cal-day--today.cal-day--checked {
  background: rgba(18, 89, 143, 0.14);
  border-color: #184a72;
  box-shadow: 0 0 0 4rpx rgba(18, 89, 143, 0.18);
}

.cal-day-num {
  font-size: 28rpx;
  line-height: 1;
}

.cal-day-hover {
  opacity: 0.82;
}
