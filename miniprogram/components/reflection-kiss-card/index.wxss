.reflection-kiss-card {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 48rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
}

.kiss-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

.kiss-row {
  margin-bottom: 24rpx;
  padding-left: 0;
  box-sizing: border-box;
}

.kiss-row:last-child {
  margin-bottom: 0;
}

.kiss-row-emphasis {
  padding-left: 20rpx;
  border-left: 6rpx solid #c0713b;
}

.kiss-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #184061;
  margin-bottom: 12rpx;
}

.textarea-wrap {
  position: relative;
  padding-bottom: 88rpx;
  box-sizing: border-box;
}

.kiss-textarea {
  width: 100%;
  min-height: 120rpx;
  background: #f7f9fb;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #184061;
  line-height: 1.6;
}

.kiss-placeholder {
  color: #8a9cb0;
  font-size: 26rpx;
}

.limit-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
}

.limit-tip {
  position: absolute;
  left: 4rpx;
  bottom: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  color: #8a9cb0;
}

.speech-mic-hit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 88rpx;
  height: 88rpx;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  background: transparent;
  border: none;
  box-shadow: none;
}

.speech-mic-hit-disabled {
  opacity: 0.35;
  pointer-events: none;
}

.speech-mic-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  box-sizing: border-box;
}

.speech-mic-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 16rpx;
  height: 22rpx;
  margin-left: -8rpx;
  border-radius: 10rpx;
  background: var(--accent, #c0713b);
}

.speech-mic-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  width: 24rpx;
  height: 12rpx;
  margin-left: -12rpx;
  border: 3rpx solid var(--accent, #c0713b);
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.speech-wave {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  pointer-events: none;
}

.speech-wave-bar {
  width: 4rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: var(--accent, #c0713b);
  animation: kiss-speech-wave 0.9s ease-in-out infinite;
}

.speech-mic-icon,
.speech-wave {
  pointer-events: none;
}

@keyframes kiss-speech-wave {
  0%,
  100% {
    height: 10rpx;
    opacity: 0.45;
  }
  50% {
    height: 32rpx;
    opacity: 1;
  }
}
