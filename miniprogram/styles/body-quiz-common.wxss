page {
  background-color: #f7f9fb;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f7f9fb 0%, #eef6ff 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.card {
  width: 100%;
  max-width: 694rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(212, 233, 255, 0.45);
  box-sizing: border-box;
}

.title {
  display: block;
  text-align: center;
  color: #12598f;
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.option {
  border: 2rpx solid #dbe5ef;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
}

.option.active {
  border-color: #12598f;
  background: #edf6fd;
}

.main {
  display: block;
  font-size: 30rpx;
  color: #184061;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #577388;
}

.btn {
  margin-top: 20rpx;
  width: 100%;
  max-width: 100%;
  min-width: 360rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: #12598f;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  white-space: nowrap;
}

.progress {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  color: #8a9cb0;
  font-size: 22rpx;
}
