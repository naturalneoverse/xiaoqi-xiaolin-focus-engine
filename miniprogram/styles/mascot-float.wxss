/**
 * 小麒 / 小麟独立形象：纯阴影立体浮出 + 心跳节奏轻微呼吸（仅 scale，无旋转/晃动）
 * 周期 850ms ≈ 70bpm；缩放 1 ~ 1.02
 */
.mascot-float-3d {
  display: inline-block;
  vertical-align: bottom;
  box-sizing: border-box;
  transform-origin: center bottom;
  animation: mascot-float-breathe 850ms ease-in-out infinite;
  filter:
    drop-shadow(0 6rpx 10rpx rgba(24, 64, 97, 0.14))
    drop-shadow(0 14rpx 24rpx rgba(24, 64, 97, 0.11))
    drop-shadow(0 26rpx 40rpx rgba(24, 64, 97, 0.07));
}

.mascot-float-3d.mascot-float-paused {
  animation-play-state: paused;
}

.mascot-float-3d .mascot-float-img,
.mascot-float-3d image {
  display: block;
  width: 100%;
  height: 100%;
}

@keyframes mascot-float-breathe {
  0%,
  100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}
