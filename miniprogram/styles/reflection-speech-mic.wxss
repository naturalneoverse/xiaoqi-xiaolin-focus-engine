/**
 * 哲思/任务手写区：话筒按钮（Step2：更大图标 + 更大透明热区）
 * --speech-mic-color 可由父级覆盖（象限主题色）
 */

.speech-mic-corner {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.speech-mic-corner--card {
  width: 128rpx;
  height: 88rpx;
}

.speech-mic-corner--expand {
  width: 120rpx;
  height: 88rpx;
}

.speech-mic-btn {
  width: 100% !important;
  height: 100% !important;
  padding: 0;
  margin: 0;
  line-height: 1;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  border-radius: 0;
  box-shadow: none;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  box-sizing: border-box;
  position: relative;
}

.speech-mic-btn::after {
  display: none !important;
  border: none !important;
}

.speech-mic-btn-disabled {
  opacity: 0.35;
}

.speech-layer-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.speech-mic-icon {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  box-sizing: border-box;
}

.speech-mic-icon::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 5rpx;
  width: 20rpx;
  height: 28rpx;
  margin-left: -10rpx;
  border-radius: 12rpx;
  background: var(--speech-mic-color, #12598f);
}

.speech-mic-icon::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 5rpx;
  width: 30rpx;
  height: 14rpx;
  margin-left: -15rpx;
  border: 3rpx solid var(--speech-mic-color, #12598f);
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  box-sizing: border-box;
}

.speech-mic-btn-recording .speech-wave-bar {
  background: var(--speech-mic-color, #12598f);
}

.speech-mic-icon,
.speech-wave {
  pointer-events: none;
}

.speech-wave {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: absolute;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.speech-wave-bar {
  width: 4rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: #6c92b1;
  animation: reflection-speech-wave-pulse 0.9s ease-in-out infinite;
}

@keyframes reflection-speech-wave-pulse {
  0%,
  100% {
    height: 10rpx;
    opacity: 0.45;
  }
  50% {
    height: 32rpx;
    opacity: 1;
  }
}

/* Step3：按住录音时，话筒左侧微信式语音条 */
.speech-hold-bar {
  position: absolute;
  left: 100rpx;
  right: 128rpx;
  bottom: 12rpx;
  height: 64rpx;
  z-index: 9;
  border-radius: 32rpx;
  background: var(--speech-mic-color, #12598f);
  box-shadow: 0 4rpx 16rpx rgba(18, 89, 143, 0.22);
  display: flex;
  align-items: center;
  padding: 0 20rpx 0 24rpx;
  gap: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
  transform-origin: right center;
  animation: reflection-speech-hold-bar-in 0.18s ease-out;
}

.speech-hold-bar--wide-counter {
  left: 128rpx;
}

@keyframes reflection-speech-hold-bar-in {
  from {
    opacity: 0;
    transform: scaleX(0.9);
  }
  to {
    opacity: 1;
    transform: scaleX(1);
  }
}

.speech-hold-wave {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  height: 100%;
}

.speech-hold-wave-bar {
  width: 4rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.88);
  animation: reflection-speech-hold-wave 0.85s ease-in-out infinite;
}

@keyframes reflection-speech-hold-wave {
  0%,
  100% {
    height: 12rpx;
    opacity: 0.5;
  }
  50% {
    height: 36rpx;
    opacity: 1;
  }
}

.speech-hold-tip {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.96);
  line-height: 1;
}
