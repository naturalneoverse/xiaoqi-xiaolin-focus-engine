<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="nav">
    <view class="back tap-target" bindtap="onBack">
      <image class="close-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <text class="nav-title">创建新任务</text>
    <view class="nav-space"></view>
  </view>

  <text class="quote">“记下你要做的，时间就有了形状。”</text>

  <view class="input-card">
    <text class="label">任务名称</text>
    <view class="input-field-wrap input-field-wrap-name">
      <view class="input-row input-row-textarea">
        <textarea
          class="textarea input-field input-field-name"
          placeholder="输入任务名称"
          placeholder-class="placeholder-text"
          value="{{taskName}}"
          maxlength="200"
          adjust-position
          hold-keyboard="{{false}}"
          show-confirm-bar="{{false}}"
          confirm-type="done"
          disabled="{{showDateModal || showReminderModal || speechRecordingTarget === 'content'}}"
          bindinput="onTaskNameInput"
        />
      </view>
      <text class="limit-tip limit-tip-corner {{speechRecordingTarget === 'name' ? 'speech-layer-hidden' : ''}} {{taskNameLength > taskNameMax ? 'limit-tip-exceeded' : ''}}">{{taskNameLength}}/{{taskNameMax}}</text>
      <view
        class="speech-hold-bar {{speechRecordingTarget === 'name' ? '' : 'speech-layer-hidden'}}"
        style="--speech-mic-color: #6c92b1;"
      >
        <view class="speech-hold-wave">
          <view class="speech-hold-wave-bar" style="animation-delay: 0ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 100ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 200ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 300ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 400ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 500ms"></view>
        </view>
        <text class="speech-hold-tip">松手填入</text>
      </view>
      <view class="speech-mic-corner speech-mic-corner--card" style="--speech-mic-color: #6c92b1;">
        <button
          class="speech-mic-btn {{speechRecordingTarget === 'name' ? 'speech-mic-btn-recording' : ''}} {{speechNameMicDisabled ? 'speech-mic-btn-disabled' : ''}}"
          plain
          hover-class="none"
          disabled="{{speechNameMicDisabled}}"
          data-field="name"
          catchlongpress="onSpeechLongPress"
          catchtouchend="onSpeechTouchEnd"
          catchtouchcancel="onSpeechTouchEnd"
        >
          <view wx:if="{{speechRecordingTarget === 'name'}}" class="speech-wave">
            <view class="speech-wave-bar" style="animation-delay: 0ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 120ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 240ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 360ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 480ms"></view>
          </view>
          <view wx:else class="speech-mic-icon"></view>
        </button>
      </view>
    </view>
    <text wx:if="{{taskNameError}}" class="limit-error">{{taskNameError}}</text>
  </view>

  <view class="input-card">
    <text class="label">任务内容</text>
    <view class="input-field-wrap input-field-wrap-content">
      <view class="input-row input-row-textarea">
        <textarea
          class="textarea input-field"
          placeholder="详细描述你的任务..."
          placeholder-class="placeholder-text"
          value="{{taskContent}}"
          maxlength="2000"
          auto-height
          adjust-position
          hold-keyboard="{{false}}"
          show-confirm-bar="{{false}}"
          confirm-type="done"
          disabled="{{showDateModal || showReminderModal || speechRecordingTarget === 'name'}}"
          bindinput="onTaskContentInput"
        />
      </view>
      <text class="limit-tip limit-tip-corner {{speechRecordingTarget === 'content' ? 'speech-layer-hidden' : ''}} {{taskContentLength > taskContentMax ? 'limit-tip-exceeded' : ''}}">{{taskContentLength}}/{{taskContentMax}}</text>
      <view
        class="speech-hold-bar speech-hold-bar--wide-counter {{speechRecordingTarget === 'content' ? '' : 'speech-layer-hidden'}}"
        style="--speech-mic-color: #6c92b1;"
      >
        <view class="speech-hold-wave">
          <view class="speech-hold-wave-bar" style="animation-delay: 0ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 100ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 200ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 300ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 400ms"></view>
          <view class="speech-hold-wave-bar" style="animation-delay: 500ms"></view>
        </view>
        <text class="speech-hold-tip">松手填入</text>
      </view>
      <view class="speech-mic-corner speech-mic-corner--card" style="--speech-mic-color: #6c92b1;">
        <button
          class="speech-mic-btn {{speechRecordingTarget === 'content' ? 'speech-mic-btn-recording' : ''}} {{speechContentMicDisabled ? 'speech-mic-btn-disabled' : ''}}"
          plain
          hover-class="none"
          disabled="{{speechContentMicDisabled}}"
          data-field="content"
          catchlongpress="onSpeechLongPress"
          catchtouchend="onSpeechTouchEnd"
          catchtouchcancel="onSpeechTouchEnd"
        >
          <view wx:if="{{speechRecordingTarget === 'content'}}" class="speech-wave">
            <view class="speech-wave-bar" style="animation-delay: 0ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 120ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 240ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 360ms"></view>
            <view class="speech-wave-bar" style="animation-delay: 480ms"></view>
          </view>
          <view wx:else class="speech-mic-icon"></view>
        </button>
      </view>
    </view>
    <text wx:if="{{taskContentError}}" class="limit-error">{{taskContentError}}</text>
  </view>

  <view class="grid">
    <view class="grid-item">
      <view class="box" bindtap="openDateModal">
        <image class="icon-calendar" src="/images/transparent background/calendar.png" mode="aspectFit" binderror="onImageError" />
        <text class="box-main">选择日期</text>
        <text class="box-sub">{{dateText}}</text>
      </view>
    </view>
    <view class="grid-item">
      <view class="box" bindtap="openReminderModal">
        <image class="icon-remind" src="/images/transparent background/alarm.png" mode="aspectFit" binderror="onImageError" />
        <text class="box-main">设置提醒</text>
        <text class="box-sub">{{reminderText}}</text>
      </view>
    </view>
  </view>

  <button class="btn" bindtap="next" disabled="{{submitting}}">{{submitting ? '提交中...' : '下一步'}}</button>

  <view wx:if="{{showDateModal}}" class="modal-mask" bindtap="closeDateModal">
    <view class="modal-panel" catchtap="noop">
      <text class="modal-title">选择日期</text>
      <view class="modal-row">
        <text class="modal-label">开始日期</text>
        <picker mode="date" value="{{draftStartDate}}" bindchange="onDraftStartDateChange">
          <text class="modal-value">{{draftStartDate}}</text>
        </picker>
      </view>
      <view class="modal-row">
        <text class="modal-label">结束日期</text>
        <picker mode="date" value="{{draftEndDate}}" start="{{draftStartDate}}" bindchange="onDraftEndDateChange">
          <text class="modal-value">{{draftEndDate || "不填写"}}</text>
        </picker>
      </view>
      <text class="modal-link" bindtap="clearDraftEndDate">清空结束日期</text>
      <view class="modal-actions">
        <button class="modal-btn modal-btn-light" bindtap="closeDateModal">取消</button>
        <button class="modal-btn" bindtap="confirmDateModal">确定</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showReminderModal}}" class="modal-mask" bindtap="closeReminderModal">
    <view class="modal-panel" catchtap="noop">
      <text class="modal-title">设置提醒</text>
      <view class="modal-row">
        <text class="modal-label">提醒时间</text>
        <picker mode="time" value="{{reminderTime}}" bindchange="onReminderTimeChange">
          <text class="modal-value">{{reminderTime || "选择时间"}}</text>
        </picker>
      </view>
      <view class="modal-row">
        <text class="modal-label">提醒频率</text>
        <picker
          mode="selector"
          range="{{reminderFrequencyOptions}}"
          value="{{reminderFrequencyIndex}}"
          bindchange="onReminderFrequencyChange"
          disabled="{{!reminderTime}}"
        >
          <text class="modal-value {{!reminderTime ? 'modal-value-disabled' : ''}}">{{reminderFrequency}}</text>
        </picker>
      </view>
      <view class="modal-actions">
        <button class="modal-btn modal-btn-light" bindtap="closeReminderModal">取消</button>
        <button class="modal-btn" bindtap="confirmReminderModal">确定</button>
      </view>
    </view>
  </view>

  <calendar-guide-dialog id="calendar-guide-dialog" />
</view>
