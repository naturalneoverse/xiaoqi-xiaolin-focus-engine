<view class="page {{showReflectionBtn ? 'page-with-reflection-btn' : ''}}" style="{{_globalSafeAreaStyle}}">
  <view class="top-bar">
    <view class="back-wrap tap-target" catchtap="goHome" hover-class="top-bar-hover">
      <image class="close-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <text class="page-title">任务详情</text>
    <view class="top-space"></view>
  </view>
  <text class="task-name">{{taskName}}</text>

  <view class="card">
    <text class="desc">{{taskContent}}</text>
  </view>

  <view class="card row">
    <text class="k">日期</text>
    <text class="v">{{dateText}}</text>
  </view>

  <view class="card">
    <text class="k">标签</text>
    <view class="tags">
      <text wx:for="{{tags}}" wx:key="*this" class="tag">{{item}}</text>
      <text wx:if="{{!tags.length}}" class="tag">暂无标签</text>
    </view>
  </view>

  <view class="card row">
    <text class="k">状态</text>
    <picker
      mode="selector"
      range="{{statusOptions}}"
      value="{{statusIndex}}"
      bindchange="onStatusChange"
      class="status-picker"
    >
      <view class="status-picker-inner">
        <text class="v status-value {{statusClass}}">{{statusText}}</text>
        <text class="status-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <view class="card reminder-card" wx:if="{{taskId}}">
    <text class="k">提醒</text>
    <view class="reminder-row">
      <text class="rk">每日时间</text>
      <picker mode="time" value="{{reminderTime}}" bindchange="onDetailReminderTimeChange">
        <view class="reminder-picker tap-target">{{reminderTime || "选择时间"}}</view>
      </picker>
    </view>
    <view class="reminder-row">
      <text class="rk">重复</text>
      <picker
        mode="selector"
        range="{{detailReminderFreqOptions}}"
        value="{{detailReminderFreqIndex}}"
        bindchange="onDetailReminderFreqChange"
      >
        <view class="reminder-picker tap-target">{{reminderFrequency}}</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{showReflectionBtn}}" class="reflection-entry-wrap">
    <view class="mascot-float-3d reflection-entry-float {{mascotAnimPaused ? 'mascot-float-paused' : ''}}">
      <button class="reflection-entry-btn" plain hover-class="reflection-entry-btn-hover" bindtap="goReflection">
        <text class="reflection-entry-text">哲思复盘</text>
      </button>
    </view>
  </view>

  <view wx:if="{{showMascotModal}}" class="mascot-mask" bindtap="closeMascotModal">
    <view class="mascot-modal" catchtap="noop">
      <text class="mascot-title">提交成功</text>
      <text class="mascot-subtitle">小麒来为您庆祝啦</text>
      <view class="mascot-stage">
        <view class="mascot-image-wrap">
          <view class="mascot-float-3d {{mascotAnimPaused ? 'mascot-float-paused' : ''}}">
            <image class="mascot-image mascot-float-img" src="{{xiaoqiImage}}" mode="aspectFit" binderror="onImageError" data-err-field="xiaoqiImage" />
          </view>
        </view>
        <view class="mascot-bubble-wrap">
          <view
            wx:if="{{companionBubbleLines && companionBubbleLines.length}}"
            class="companion-bubble-card"
          >
            <view class="companion-bubble-body">
              <text
                wx:for="{{companionBubbleLines}}"
                wx:key="index"
                class="companion-bubble-line"
              >{{item}}</text>
            </view>
          </view>
          <chat-bubble
            wx:else
            text="{{mascotBubbleText}}"
            color="#b7d6ea"
            arrowPosition="left"
            keepManualBreak="{{true}}"
            maxLength="{{200}}"
            size="lg"
          />
        </view>
      </view>
      <button class="mascot-btn" bindtap="closeMascotModal">知道了</button>
    </view>
  </view>
</view>
