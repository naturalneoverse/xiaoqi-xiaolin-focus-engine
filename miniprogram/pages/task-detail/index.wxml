<view class="page {{showReflectionBtn ? 'page-with-reflection-btn' : ''}}" style="{{_globalSafeAreaStyle}}">
  <view class="page-scroll-body">
  <view class="top-bar">
    <view class="back-wrap tap-target" catchtap="goHome" hover-class="top-bar-hover">
      <image class="close-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <text class="page-title">任务详情</text>
    <view class="top-space"></view>
  </view>
  <text class="task-name">{{taskName}}</text>

  <view class="card content-card">
    <view class="content-card-head">
      <text class="k">详细内容</text>
      <view class="content-card-actions" wx:if="{{!contentEditing}}">
        <text class="content-action-link" catchtap="enterContentEdit">编辑</text>
      </view>
      <view class="content-card-actions" wx:else>
        <text class="content-action-link content-action-primary" catchtap="saveContentEdit">保存</text>
        <text class="content-action-link" catchtap="cancelContentEdit">取消</text>
      </view>
    </view>
    <view wx:if="{{!contentEditing}}" class="content-readonly">
      <text class="desc {{contentExpanded ? 'desc-expanded' : 'desc-clamped'}}">{{contentDisplayText}}</text>
      <view wx:if="{{contentShowExpandToggle}}" class="content-expand-row">
        <text class="content-expand-link tap-target" catchtap="toggleContentExpand">{{contentExpanded ? '收起' : '展开全文'}}</text>
      </view>
    </view>
    <block wx:else>
      <view class="content-edit-wrap">
        <textarea
          class="content-textarea"
          value="{{contentDraft}}"
          bindinput="onContentDraftInput"
          maxlength="{{taskContentMax}}"
          auto-height
          focus="{{contentEditingFocus}}"
          placeholder="详细描述你的任务..."
          show-confirm-bar="{{false}}"
          disabled="{{speechRecordingTarget === 'content'}}"
        />
        <view
          class="speech-hold-bar speech-hold-bar--wide-counter {{speechRecordingTarget === 'content' ? '' : 'speech-layer-hidden'}}"
          style="--speech-mic-color: #6c92b1;"
        >
          <view class="speech-hold-wave">
            <view class="speech-hold-wave-bar" style="animation-delay: 0ms"></view>
            <view class="speech-hold-wave-bar" style="animation-delay: 100ms"></view>
            <view class="speech-hold-wave-bar" style="animation-delay: 200ms"></view>
            <view class="speech-hold-wave-bar" style="animation-delay: 300ms"></view>
            <view class="speech-hold-wave-bar" style="animation-delay: 400ms"></view>
            <view class="speech-hold-wave-bar" style="animation-delay: 500ms"></view>
          </view>
          <text class="speech-hold-tip">松手填入</text>
        </view>
        <view class="content-limit-row">
          <text class="content-limit {{contentDraftLength > taskContentMax ? 'content-limit-exceeded' : ''}}">{{contentDraftLength}}/{{taskContentMax}}</text>
          <view class="speech-mic-corner speech-mic-corner--inline" style="--speech-mic-color: #6c92b1;">
            <button
              class="speech-mic-btn {{speechRecordingTarget === 'content' ? 'speech-mic-btn-recording' : ''}} {{speechContentMicDisabled ? 'speech-mic-btn-disabled' : ''}}"
              plain
              hover-class="none"
              disabled="{{speechContentMicDisabled}}"
              data-field="content"
              catchlongpress="onSpeechLongPress"
              catchtouchend="onSpeechTouchEnd"
              catchtouchcancel="onSpeechTouchEnd"
            >
              <view wx:if="{{speechRecordingTarget === 'content'}}" class="speech-wave">
                <view class="speech-wave-bar" style="animation-delay: 0ms"></view>
                <view class="speech-wave-bar" style="animation-delay: 120ms"></view>
                <view class="speech-wave-bar" style="animation-delay: 240ms"></view>
                <view class="speech-wave-bar" style="animation-delay: 360ms"></view>
                <view class="speech-wave-bar" style="animation-delay: 480ms"></view>
              </view>
              <view wx:else class="speech-mic-icon"></view>
            </button>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="card subtask-card">
    <view class="subtask-head">
      <text class="k">子任务（{{subtaskDone}}/{{subtaskTotal}}）</text>
      <view class="subtask-bar" wx:if="{{subtaskTotal > 0}}">
        <view class="subtask-bar-fill" style="width: {{subtaskProgressPercent}}%;"></view>
      </view>
    </view>
    <text wx:if="{{subtaskAllDoneHint}}" class="subtask-all-done-hint">子步骤已全部完成，可在上方将任务标记为已完成</text>
    <view wx:if="{{subtaskTotal === 0}}" class="subtask-empty">暂无子任务，点击下方添加</view>
    <view
      wx:for="{{subtasksVisible}}"
      wx:key="id"
      class="subtask-row tap-target"
      bindtap="onTapSubtaskRow"
      data-id="{{item.id}}"
    >
      <view class="subtask-check-wrap" catchtap="onToggleSubtask" data-id="{{item.id}}">
        <text class="subtask-check {{item.done ? 'subtask-check-done' : ''}}">{{item.done ? '✓' : '○'}}</text>
      </view>
      <text class="subtask-title {{item.done ? 'subtask-title-done' : ''}}">{{item.title}}</text>
      <text wx:if="{{item.dateLabel}}" class="subtask-date">{{item.dateLabel}}</text>
    </view>
    <view
      wx:if="{{subtaskFoldable}}"
      class="subtask-fold-row tap-target"
      catchtap="onToggleSubtaskExpand"
    >
      <text class="subtask-fold-link">{{subtaskExpanded ? '收起' : '展开全部（还有 ' + subtaskHiddenCount + ' 条）'}}</text>
    </view>
    <view
      class="subtask-add tap-target {{subtaskAtLimit ? 'subtask-add-limit' : (subtaskCanAdd ? '' : 'subtask-add-disabled')}}"
      catchtap="onTapAddSubtask"
    >+ 添加子任务</view>
    <view wx:if="{{showConvertPicker}}" class="subtask-convert-panel">
      <text class="subtask-convert-tip">已达 20 条上限，选择一条转为独立任务后可继续添加：</text>
      <view
        wx:for="{{convertCandidates}}"
        wx:key="id"
        class="subtask-convert-row tap-target"
        catchtap="onSelectConvertSubtask"
        data-id="{{item.id}}"
      >
        <text class="subtask-convert-title">{{item.title}}</text>
        <text class="subtask-convert-action">转为独立 ›</text>
      </view>
      <text class="subtask-convert-cancel tap-target" catchtap="onCancelConvertPicker">取消</text>
    </view>
  </view>

  <view class="card row">
    <text class="k">日期</text>
    <text class="v">{{dateText}}</text>
  </view>

  <view class="card">
    <text class="k">标签</text>
    <view class="tags">
      <text wx:for="{{tags}}" wx:key="*this" class="tag">{{item}}</text>
      <text wx:if="{{!tags.length}}" class="tag">暂无标签</text>
    </view>
  </view>

  <view class="card row">
    <text class="k">状态</text>
    <picker
      mode="selector"
      range="{{statusOptions}}"
      value="{{statusIndex}}"
      bindchange="onStatusChange"
      class="status-picker"
    >
      <view class="status-picker-inner">
        <text class="v status-value {{statusClass}}">{{statusText}}</text>
        <text class="status-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <view class="card reminder-card" wx:if="{{taskId}}">
    <view class="reminder-card-head">
      <view class="reminder-card-head-main tap-target" catchtap="toggleReminderExpand">
        <text class="k">提醒</text>
        <text class="reminder-chevron {{reminderExpanded ? 'reminder-chevron-open' : ''}}">⌄</text>
      </view>
      <text
        wx:if="{{reminderExpanded && statusText !== '已完成' && statusText !== '已取消'}}"
        class="reminder-sync-link {{!reminderTime || reminderCalendarSubmitting ? 'reminder-sync-link-disabled' : ''}}"
        catchtap="confirmDetailReminderCalendar"
      >{{reminderCalendarSubmitting ? '写入中…' : '写入日历'}}</text>
    </view>
    <text class="reminder-summary-line">{{reminderSummaryLine}}</text>
    <block wx:if="{{reminderExpanded}}">
    <view class="reminder-row">
      <text class="rk">起始日期</text>
      <picker mode="date" value="{{reminderStartDate}}" bindchange="onDetailReminderStartChange">
        <view class="reminder-picker tap-target">{{reminderStartDate || "选择日期"}}</view>
      </picker>
    </view>
    <view class="reminder-row">
      <text class="rk">结束日期</text>
      <picker mode="date" value="{{reminderEndDate}}" start="{{reminderStartDate}}" bindchange="onDetailReminderEndChange">
        <view class="reminder-picker tap-target">{{reminderEndDate || "不填写"}}</view>
      </picker>
    </view>
    <text wx:if="{{reminderEndDate}}" class="reminder-clear-end tap-target" catchtap="clearReminderEndDate">清空结束日期</text>
    <view class="reminder-row">
      <text class="rk">提醒时间</text>
      <picker mode="time" value="{{reminderTime}}" bindchange="onDetailReminderTimeChange">
        <view class="reminder-picker tap-target">{{reminderTime || "选择时间"}}</view>
      </picker>
    </view>
    <view class="reminder-row">
      <text class="rk">重复</text>
      <picker
        mode="selector"
        range="{{detailReminderFreqOptions}}"
        value="{{detailReminderFreqIndex}}"
        bindchange="onDetailReminderFreqChange"
      >
        <view class="reminder-picker tap-target">{{reminderFrequency}}</view>
      </picker>
    </view>
    <text wx:if="{{nextReminderLabel}}" class="next-reminder-label">{{nextReminderLabel}}</text>
    <text wx:elif="{{reminderTime && reminderStartDate && !nextReminderLabel}}" class="reminder-hint-warn">请先完善起始日期与提醒时间</text>
    <text class="reminder-hint">选好后点「写入日历」同步本机；换机需重新确认，删任务不会自动取消日历条目。</text>
    </block>
  </view>

  <view class="page-scroll-tail {{showReflectionBtn ? 'page-scroll-tail-action' : ''}}"></view>
  </view>

  <view wx:if="{{showReflectionBtn}}" class="page-action-bar">
    <view class="page-action-btn-wrap page-action-btn--breathe {{mascotAnimPaused ? 'page-action-btn--breathe-paused' : ''}}">
      <button class="page-action-btn page-action-btn-glass" plain hover-class="page-action-btn-hover" bindtap="goReflection">哲思复盘</button>
    </view>
  </view>

  <view wx:if="{{showMascotModal}}" class="mascot-mask" bindtap="closeMascotModal">
    <view class="mascot-modal" catchtap="noop">
      <text class="mascot-title">提交成功</text>
      <text class="mascot-subtitle">小麒来为您庆祝啦</text>
      <view class="mascot-stage">
        <view class="mascot-image-wrap">
          <view class="mascot-float-3d {{mascotAnimPaused ? 'mascot-float-paused' : ''}}">
            <image class="mascot-image mascot-float-img" src="{{xiaoqiImage}}" mode="aspectFit" binderror="onImageError" data-err-field="xiaoqiImage" />
          </view>
        </view>
        <view class="mascot-bubble-wrap">
          <view
            wx:if="{{companionBubbleLines && companionBubbleLines.length}}"
            class="companion-bubble-card"
          >
            <view class="companion-bubble-body">
              <text
                wx:for="{{companionBubbleLines}}"
                wx:key="index"
                class="companion-bubble-line"
              >{{item}}</text>
            </view>
          </view>
          <chat-bubble
            wx:else
            text="{{mascotBubbleText}}"
            color="#b7d6ea"
            arrowPosition="left"
            keepManualBreak="{{true}}"
            maxLength="{{200}}"
            size="lg"
          />
        </view>
      </view>
      <button class="mascot-btn" bindtap="closeMascotModal">知道了</button>
    </view>
  </view>
</view>
