page {
  background: linear-gradient(180deg, #eff7fd 0%, #d6ebf7 100%);
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.top-nav {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.close-btn {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.top-nav-space {
  width: 74rpx;
  height: 74rpx;
}

.task-name {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #184061;
}

.card {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 22rpx;
}

.desc {
  color: #577388;
  line-height: 1.8;
  font-size: 25rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.k {
  color: #184061;
  font-size: 28rpx;
  font-weight: 600;
}

.v {
  color: #577388;
  font-size: 25rpx;
}

.status-picker {
  display: block;
}

.status-picker-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-arrow {
  color: #7f95aa;
  font-size: 24rpx;
  transform: translateY(-2rpx);
}

.status-value-completed {
  color: #2f9e44;
}

.status-value-delayed {
  color: #d97706;
}

.status-value-cancelled {
  color: #9ca3af;
  text-decoration: line-through;
}

.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #edf6fd;
  color: #12598f;
  font-size: 22rpx;
}

.mascot-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.mascot-modal {
  width: 620rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 34rpx 30rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
  position: relative;
}

.mascot-title {
  display: block;
  color: #184061;
  font-size: 40rpx;
  font-weight: 700;
}

.mascot-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #577388;
  font-size: 26rpx;
}

.mascot-stage {
  position: relative;
  margin-top: 16rpx;
  height: 360rpx;
}

.mascot-image-wrap {
  position: absolute;
  left: -26rpx;
  top: 62%;
  transform: translateY(-50%);
  width: 220rpx;
  height: 220rpx;
  padding-top: 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.mascot-image {
  width: 200rpx;
  height: 200rpx;
  transform: scaleX(1);
}

.mascot-bubble {
  position: absolute;
  right: 0;
  top: 0;
  width: 420rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 56% 44% 52% 48% / 46% 58% 42% 54%;
  padding: 16rpx 18rpx;
  text-align: left;
  box-sizing: border-box;
  z-index: 2;
}

.mascot-bubble-wrap {
  position: absolute;
  right: 0;
  top: 0;
  width: 420rpx;
  z-index: 2;
}

.mascot-bubble-wrap chat-bubble {
  max-width: 100%;
}

.mascot-bubble::before {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -18rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 18rpx solid #e5e7eb;
}

.mascot-bubble::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -16rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 16rpx solid #ffffff;
}

.mascot-bubble-text {
  display: block;
  color: #184061;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.55;
}

.mascot-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #12598f;
  color: #ffffff;
  font-size: 28rpx;
}
