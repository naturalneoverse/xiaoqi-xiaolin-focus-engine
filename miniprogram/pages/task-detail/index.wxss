@import "../../styles/mascot-float.wxss";

page {
  background: linear-gradient(180deg, #eff7fd 0%, #d6ebf7 100%);
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.page-with-reflection-btn {
  padding-bottom: 160rpx;
}

.top-bar {
  position: relative;
  z-index: 100;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.back-wrap,
.top-space {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.page-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #184061;
}

.top-bar-hover {
  opacity: 0.85;
}

.task-name {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 42rpx;
  font-weight: 700;
  color: #184061;
}

.card {
  margin-top: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 22rpx;
}

.desc {
  color: #577388;
  line-height: 1.8;
  font-size: 25rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.k {
  color: #184061;
  font-size: 28rpx;
  font-weight: 600;
}

.v {
  color: #577388;
  font-size: 25rpx;
}

.status-picker {
  display: block;
}

.status-picker-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-arrow {
  color: #7f95aa;
  font-size: 24rpx;
  transform: translateY(-2rpx);
}

.status-value-completed {
  color: #2f9e44;
}

.status-value-delayed {
  color: #d97706;
}

.status-value-cancelled {
  color: #9ca3af;
  text-decoration: line-through;
}

.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #edf6fd;
  color: #12598f;
  font-size: 22rpx;
}

.reminder-card {
  margin-top: 18rpx;
}

.reminder-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.rk {
  flex-shrink: 0;
  color: #577388;
  font-size: 26rpx;
}

.reminder-picker {
  flex: 1;
  text-align: right;
  color: #184061;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 16rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
}

.tap-target {
  min-height: 44rpx;
}

.mascot-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.mascot-modal {
  width: 660rpx;
  border-radius: 28rpx;
  background: #ffffff;
  padding: 34rpx 28rpx 28rpx;
  box-sizing: border-box;
  text-align: center;
  position: relative;
}

.mascot-title {
  display: block;
  color: #184061;
  font-size: 40rpx;
  font-weight: 700;
}

.mascot-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #577388;
  font-size: 26rpx;
}

.mascot-stage {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  min-height: 320rpx;
  height: auto;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.mascot-image-wrap {
  position: relative;
  flex-shrink: 0;
  width: 188rpx;
  height: 188rpx;
  margin-left: -8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.mascot-image-wrap .mascot-float-3d {
  width: 176rpx;
  height: 176rpx;
}

.mascot-bubble {
  position: absolute;
  right: 0;
  top: 0;
  width: 420rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 56% 44% 52% 48% / 46% 58% 42% 54%;
  padding: 16rpx 18rpx;
  text-align: left;
  box-sizing: border-box;
  z-index: 2;
}

.mascot-bubble-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
  margin-left: 4rpx;
  z-index: 1;
}

.mascot-bubble-wrap chat-bubble {
  display: block;
  width: 100%;
  max-width: 100%;
}

/* 外层：尾巴；内层：椭圆框 + overflow 裁切文字 */
.companion-bubble-card {
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.companion-bubble-body {
  position: relative;
  width: 100%;
  min-height: 128rpx;
  box-sizing: border-box;
  padding: 36rpx 32rpx 32rpx 44rpx;
  border: 3rpx solid #b7d6ea;
  border-radius: 44rpx;
  background: #ffffff;
  text-align: left;
  overflow: hidden;
}

.companion-bubble-card::after {
  content: "";
  position: absolute;
  left: -11rpx;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-top: -8rpx;
  background: #ffffff;
  border-left: 3rpx solid #b7d6ea;
  border-bottom: 3rpx solid #b7d6ea;
  border-radius: 0 0 0 12rpx;
  transform: rotate(34deg);
  pointer-events: none;
  z-index: 1;
}

.companion-bubble-line {
  display: block;
  color: #184061;
  font-size: 32rpx;
  line-height: 1.58;
  font-weight: 400;
  text-align: left;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.companion-bubble-line + .companion-bubble-line {
  margin-top: 16rpx;
}

.mascot-bubble::before {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -18rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 18rpx solid #e5e7eb;
}

.mascot-bubble::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -16rpx;
  width: 0;
  height: 0;
  border-left: 11rpx solid transparent;
  border-right: 11rpx solid transparent;
  border-top: 16rpx solid #ffffff;
}

.mascot-bubble-text {
  display: block;
  color: #184061;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.55;
}

.reflection-entry-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 30;
  pointer-events: none;
}

.reflection-entry-float {
  pointer-events: auto;
  transform-origin: center center;
}

.reflection-entry-btn {
  min-width: 280rpx;
  height: 96rpx;
  padding: 0 48rpx;
  border-radius: 48rpx;
  background: #12598f !important;
  box-shadow: 0 8rpx 32rpx rgba(14, 74, 117, 0.22);
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reflection-entry-btn-hover {
  background: #0e4a75 !important;
  opacity: 0.96;
}

.reflection-entry-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

.mascot-btn {
  margin-top: 18rpx;
  width: 100%;
  max-width: 100%;
  min-width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #12598f;
  color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}
