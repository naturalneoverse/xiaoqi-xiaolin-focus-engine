<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="top-nav">
    <view class="nav-btn tap-target" bindtap="goBack">
      <image class="nav-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <view class="top-space"></view>
  </view>
  <view class="card">
    <text class="title">今日记录已保存</text>
    <view class="row"><text class="k">睡眠</text><text class="v">{{sleepText}}</text></view>
    <view class="row"><text class="k">运动</text><text class="v">{{sportText}}</text></view>
    <view class="row"><text class="k">身体信号</text><text class="v">{{signalText}}</text></view>
  </view>

  <view class="card">
    <text class="title">小麟建议</text>
    <view class="advice-row">
      <image class="advice-mascot" src="/images/transparent background/xiaolin.png" mode="aspectFit" binderror="onImageError" />
      <chat-bubble
        text="{{adviceText}}"
        color="#b7d6ea"
        arrowPosition="left"
        maxLength="{{48}}"
      />
    </view>
  </view>

  <button class="btn" bindtap="backHome">返回身心页面</button>
</view>
