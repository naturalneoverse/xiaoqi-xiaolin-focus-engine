page {
  background: #e2eaf7;
  height: 100%;
}

.page-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.page-inner {
  min-height: 100%;
  padding: 0 30rpx 0;
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 0;
  box-sizing: border-box;
}

.my-nav {
  flex-shrink: 0;
  margin: 0 -30rpx 20rpx -30rpx;
  padding: 0 12rpx 12rpx 16rpx;
  background: #f0f7ff;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.my-nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
}

.my-nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  color: #000000;
  font-size: 34rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
}

.my-nav-spacer {
  position: relative;
  z-index: 1;
  width: 174rpx;
  flex-shrink: 0;
}

.setting-btn {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
  box-sizing: border-box;
}

.setting-icon {
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
}

.profile-card {
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
  padding: 44rpx 28rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-card-gradient {
  background: linear-gradient(145deg, #dff2ff 0%, #f2f9ff 68%, #f7fbff 100%);
  box-shadow: 0 10rpx 30rpx rgba(24, 64, 97, 0.05);
}

.avatar-wrap {
  position: relative;
  width: 170rpx;
  height: 170rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 26rpx rgba(24, 64, 97, 0.08);
  overflow: hidden;
}

.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  background: transparent;
  opacity: 0;
  z-index: 2;
}

.avatar-hit::after {
  border: none;
}

.avatar {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: #dceaf7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.avatar-image {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  display: block;
}

.name {
  margin-top: 20rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #184061;
  text-align: center;
}

.name-placeholder {
  color: #8a9cb0;
  font-weight: 400;
}

.signature {
  margin-top: 10rpx;
  color: #577388;
  font-size: 28rpx;
  text-align: center;
}

.signature-placeholder {
  color: #8a9cb0;
  font-weight: 400;
}

.name-input {
  margin-top: 20rpx;
  min-width: 320rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #184061;
  text-align: center;
}

.signature-input {
  margin-top: 10rpx;
  min-width: 420rpx;
  height: 44rpx;
  line-height: 44rpx;
  color: #7d95ad;
  font-size: 28rpx;
  text-align: center;
}

.stats {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.stat-item {
  flex: 1;
  width: 0;
  border-radius: 30rpx;
  padding: 24rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 206rpx;
}

.stat-item-hover {
  opacity: 0.92;
}

.stat-icon-wrap,
.stat-content,
.stat-icon-image {
  pointer-events: none;
}

.stat-icon-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  box-shadow: none;
  flex: 0 0 110rpx;
}

.stat-icon-image {
  width: 110rpx;
  height: 110rpx;
}

.stat-icon-image-clocking {
  width: 122rpx;
  height: 122rpx;
  filter: contrast(1.06) saturate(1.08);
}

.stat-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-title {
  font-size: 36rpx;
  color: #5f7893;
  line-height: 1.2;
  font-weight: 800;
}

.stat-value-line {
  margin-top: 4rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stat-value {
  font-size: 72rpx;
  color: #8ea8c8;
  font-weight: 800;
  line-height: 1;
}

.stat-unit {
  font-size: 22rpx;
  color: #9eb0c4;
  line-height: 1;
  font-weight: 500;
}

.guide-text {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: #577388;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.main-btn {
  margin-top: 54rpx;
  width: 82%;
  max-width: 100%;
  min-width: 420rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #1d6da8 0%, #12598f 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(18, 89, 143, 0.22);
  box-sizing: border-box;
  padding: 0 24rpx;
  white-space: nowrap;
}

.main-btn::after {
  border: none;
}

.main-btn.button-hover {
  transform: scale(0.99);
}

.section-divider {
  height: 2rpx;
  background: #e2eaf7;
  margin: 28rpx 0 0;
}

.group {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 16rpx 24rpx 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
}

.group-title {
  display: block;
  padding: 10rpx 4rpx 14rpx;
  font-size: 20rpx;
  color: #94a3b8;
  letter-spacing: 6rpx;
}

.cell {
  min-height: 126rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334155;
  font-size: 34rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.cell-tap {
  cursor: pointer;
}

.cell-hover {
  background: rgba(226, 234, 247, 0.55);
}

.cell-label,
.cell .arrow,
.stat-title,
.stat-value,
.stat-unit {
  pointer-events: none;
}

.line {
  height: 2rpx;
  background: #e2eaf7;
}

.arrow {
  color: #7f93a9;
  font-size: 36rpx;
  font-weight: 400;
}

.cell-disabled-text {
  color: #b4c2d1;
}

.cell-disabled-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.lock-icon {
  font-size: 20rpx;
  color: #b4c2d1;
}

.disabled-tip {
  font-size: 22rpx;
  color: #b4c2d1;
}

.notify-switch {
  transform: scale(0.84);
  transform-origin: right center;
}

.slogan {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  color: #9cb2c8;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.tab-safe-space {
  height: calc(204rpx + env(safe-area-inset-bottom));
}
