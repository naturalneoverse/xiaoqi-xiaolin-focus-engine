<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="{{_globalSafeAreaStyle}}">
  <view class="page-inner">
  <view class="my-nav">
    <view class="my-nav-inner">
      <view class="setting-btn tap-target" catchtap="onTapSetting">
        <image class="setting-icon" src="/images/transparent background/setting.svg" mode="aspectFit" binderror="onImageError" />
      </view>
      <text class="my-nav-title">我的中心</text>
      <view class="my-nav-spacer"></view>
    </view>
  </view>

  <view class="profile-card profile-card-gradient">
    <view class="avatar-wrap">
      <image wx:if="{{avatarSrc}}" class="avatar-image" src="{{avatarSrc}}" mode="aspectFill" binderror="onAvatarImageError" />
      <view wx:else class="avatar">👤</view>
      <view wx:if="{{isLoggedIn}}" class="avatar-hit tap-target" bindtap="onPickAvatar" />
      <view wx:else class="avatar-hit" bindtap="onTapLogin" />
    </view>
    <input
      wx:if="{{isLoggedIn && editingName}}"
      class="name-input"
      value="{{editingNicknameValue}}"
      focus
      cursor-spacing="20"
      bindinput="onNicknameInput"
      bindblur="onNicknameBlur"
      confirm-type="done"
    />
    <text
      wx:elif="{{isLoggedIn}}"
      class="name {{(!userProfile.nickname || userProfile.nickname === '用户名') ? 'name-placeholder' : ''}}"
      bindtap="startEditNickname"
    >{{(!userProfile.nickname || userProfile.nickname === '用户名') ? '空缺中' : userProfile.nickname}}</text>
    <text wx:else class="name name-placeholder" bindtap="onTapLogin">点击登录</text>
    <input
      wx:if="{{isLoggedIn && editingSignature}}"
      class="signature-input"
      value="{{editingSignatureValue}}"
      focus
      cursor-spacing="20"
      bindinput="onSignatureInput"
      bindblur="onSignatureBlur"
      confirm-type="done"
    />
    <text
      wx:elif="{{isLoggedIn}}"
      class="signature {{(!userProfile.signature || userProfile.signature === '我的个性签名') ? 'signature-placeholder' : ''}}"
      bindtap="startEditSignature"
    >{{(!userProfile.signature || userProfile.signature === '我的个性签名') ? '等你来定义我' : userProfile.signature}}</text>
    <text wx:else class="signature signature-placeholder" bindtap="onTapLogin">登录后完善资料</text>
  </view>

  <view class="stats">
    <view class="stat-item tap-target" catchtap="goMomentWeekHistory" hover-class="stat-item-hover">
      <view class="stat-icon-wrap">
        <image class="stat-icon-image" src="/images/transparent background/realme.png" mode="aspectFit" binderror="onImageError" />
      </view>
      <view class="stat-content">
        <text class="stat-title">真我时刻</text>
        <view class="stat-value-line">
          <text class="stat-value">{{momentDisplayText}}</text>
          <text class="stat-unit">{{momentUnitText}}</text>
        </view>
      </view>
    </view>
    <view class="stat-item tap-target" catchtap="goCheckInCalendar" hover-class="stat-item-hover">
      <view class="stat-icon-wrap">
        <image class="stat-icon-image stat-icon-image-clocking" src="/images/transparent background/clocking.png" mode="aspectFit" binderror="onImageError" />
      </view>
      <view class="stat-content">
        <text class="stat-title">打卡记录</text>
        <view class="stat-value-line">
          <text class="stat-value">{{streakDays}}</text>
          <text class="stat-unit">天</text>
        </view>
      </view>
    </view>
  </view>

  <text class="guide-text">让每一个真我的时刻都珍贵</text>

  <button class="main-btn" hover-class="button-hover" bindtap="goCreateTask">生成真我时刻</button>
  <view class="section-divider"></view>

  <view class="group">
    <text class="group-title">我的数据</text>
    <view class="cell cell-tap" catchtap="goTimeReport" hover-class="cell-hover">
      <text class="cell-label">时间编织报告</text>
      <text class="arrow">›</text>
    </view>
    <view class="line"></view>
    <view class="cell cell-tap" catchtap="goReflectionList" hover-class="cell-hover">
      <text class="cell-label">哲思复盘报告</text>
      <text class="arrow">›</text>
    </view>
    <view class="line"></view>
    <view class="cell cell-tap" catchtap="goBodyToday" hover-class="cell-hover">
      <text class="cell-label">身体边界记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="line"></view>
    <view class="cell cell-disabled">
      <text class="cell-disabled-text">关系边界记录</text>
      <view class="cell-disabled-right">
        <text class="lock-icon">🔒</text>
        <text class="disabled-tip">敬请期待</text>
      </view>
    </view>
  </view>

  <view class="group">
    <text class="group-title">设置</text>
    <view class="cell">
      <text>消息提醒</text>
      <switch
        class="notify-switch"
        checked="{{notifyOn}}"
        color="#12598f"
        bindchange="onNotifyChange"
      />
    </view>
    <view class="line"></view>
    <view class="cell cell-tap" catchtap="goHelp" hover-class="cell-hover">
      <text class="cell-label">帮助与支持</text>
      <text class="arrow">›</text>
    </view>
    <view class="line"></view>
    <view class="cell cell-tap" catchtap="goAbout" hover-class="cell-hover">
      <text class="cell-label">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <text class="slogan">用智慧爱自己 用行动爱世界</text>
  <view class="tab-safe-space"></view>
  </view>
</scroll-view>
