.splash-page {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #0a1628;
  overflow: hidden;
}

.splash-video-wrap {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #0a1628;
}

.splash-video {
  width: 100%;
  height: 100%;
  display: block;
}

.splash-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a1628;
}

.splash-fallback-text {
  font-size: 28rpx;
  color: #b7d6ea;
}

.splash-end-scrim {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 38vh;
  background: linear-gradient(
    180deg,
    rgba(10, 22, 40, 0) 0%,
    rgba(10, 22, 40, 0.38) 100%
  );
  z-index: 2;
  pointer-events: none;
}

.splash-sound-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  z-index: 5;
}

.splash-sound-btn text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.58);
}

.splash-enter-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 4;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.splash-enter-btn {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-enter-btn-glass {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  background: linear-gradient(
    145deg,
    rgba(255, 255, 255, 0.28) 0%,
    rgba(183, 214, 234, 0.14) 38%,
    rgba(24, 74, 114, 0.26) 100%
  );
  box-shadow:
    0 14rpx 40rpx rgba(10, 22, 40, 0.32),
    0 4rpx 12rpx rgba(10, 22, 40, 0.18),
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.38),
    inset 0 -6rpx 16rpx rgba(24, 74, 114, 0.22);
  overflow: hidden;
}

.splash-enter-btn-shine {
  position: absolute;
  left: 10%;
  top: 6%;
  width: 56%;
  height: 42%;
  border-radius: 50%;
  background: radial-gradient(
    circle at 30% 30%,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(255, 255, 255, 0) 72%
  );
  pointer-events: none;
}

.splash-enter-btn-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 112rpx;
  height: 112rpx;
  margin-left: -56rpx;
  margin-top: -56rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  background: linear-gradient(
    160deg,
    rgba(24, 74, 114, 0.18) 0%,
    rgba(24, 74, 114, 0.32) 100%
  );
  box-shadow:
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.2),
    inset 0 -4rpx 10rpx rgba(10, 22, 40, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.splash-enter-btn-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.36);
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.22) 0%,
    rgba(24, 74, 114, 0.2) 100%
  );
  box-shadow:
    inset 0 1rpx 4rpx rgba(255, 255, 255, 0.35),
    0 2rpx 8rpx rgba(10, 22, 40, 0.15);
}

.splash-enter-label {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.2;
  text-shadow: 0 2rpx 8rpx rgba(10, 22, 40, 0.32);
}

.splash-enter-btn--breathe {
  animation: splash-enter-breathe 2.4s ease-in-out infinite;
}

@keyframes splash-enter-breathe {
  0%,
  100% {
    transform: scale(0.96);
    opacity: 0.88;
  }
  50% {
    transform: scale(1);
    opacity: 1;
  }
}
