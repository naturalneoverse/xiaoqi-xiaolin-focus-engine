<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="card">
    <text class="title">今天，动得怎么样？</text>
    <view
      wx:for="{{options}}"
      wx:key="key"
      class="option {{selected === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="choose"
    >
      <text class="main">{{item.key}}</text>
      <text class="sub">{{item.desc}}</text>
    </view>
    <button class="btn" bindtap="next">下一页</button>
    <text class="progress">2 / 3</text>
  </view>
</view>
