.wrap {
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #334155;
}

.picker {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.save {
  margin-top: 24rpx;
}
