page {
  background: #e2eaf7;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.top-bar {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.back-wrap,
.top-space {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 30rpx;
  height: 30rpx;
}

.page-title {
  font-size: 34rpx;
  color: #1f476a;
  font-weight: 600;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
}

.title {
  display: block;
  font-size: 32rpx;
  color: #334155;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.p {
  display: block;
  font-size: 28rpx;
  color: #48617a;
  line-height: 1.8;
  margin-top: 10rpx;
}
