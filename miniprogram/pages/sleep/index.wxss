page {
  background: #e2eaf7;
}

.page {
  min-height: 100vh;
  padding: 16rpx 30rpx 48rpx;
  box-sizing: border-box;
}

.top-bar {
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.add-btn-icon {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.title-row {
  margin-top: 12rpx;
}

.main-title {
  color: #143b5a;
  font-size: 66rpx;
  font-weight: 700;
  line-height: 1;
}

.meta-wrap {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-date-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-date-icon {
  color: #9fb0c3;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.35;
}

.meta-date {
  color: #95a6bb;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.35;
}

.meta-progress {
  display: flex;
  align-items: center;
}

.meta-text {
  color: #56789b;
  font-size: 30rpx;
}

.task-list {
  margin-top: 34rpx;
}

.task-empty-wrap {
  margin-top: 34rpx;
  min-height: 280rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #f7fbff 0%, #edf4fc 100%);
  border: 2rpx solid rgba(186, 204, 224, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 42rpx 36rpx;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
  transition: transform 120ms ease, opacity 120ms ease;
}

.task-empty-icon {
  width: 192rpx;
  height: 192rpx;
  margin-bottom: 20rpx;
  opacity: 0.78;
}

.task-empty-wrap-hover {
  transform: scale(0.995);
  opacity: 0.96;
}

.task-empty-text {
  color: #6f86a0;
  font-size: 36rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.8;
}

.task-card {
  background: #ffffff;
  border-radius: 32rpx;
  border: 2rpx solid rgba(226, 234, 247, 0.95);
  padding: 30rpx 26rpx 32rpx;
  margin-bottom: 38rpx;
  min-height: 178rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
  transition: transform 120ms ease, background-color 120ms ease;
}

.task-card-hover {
  transform: scale(0.995);
  background: #ffffff;
}

.task-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: #9ab4cc;
}

.task-type-tech::before {
  background: #3b82f6;
}

.task-type-balance::before {
  background: #22c55e;
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.task-title {
  color: #183f5f;
  font-size: 36rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-time {
  color: #7f8fa3;
  font-size: 28rpx;
  margin-top: 4rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.task-foot {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.task-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  border-radius: 999rpx;
  padding: 7rpx 14rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #72869f;
  background: #e7eef6;
}

.tag-red {
  color: #8e4f57;
  background: #f1dfe3;
}

.tag-orange {
  color: #a5673f;
  background: #f7e4d6;
}

.tag-gray {
  color: #66758b;
  background: #e3e8f0;
}

.tag-blue {
  color: #4a78a2;
  background: #ddeaf7;
}

.tag-berry {
  color: #8c566a;
  background: #f1e2e8;
}

.tag-lavender {
  color: #6f689b;
  background: #ebe8f8;
}

.tag-sky {
  color: #567fa3;
  background: #e2eef8;
}

.tag-violet {
  color: #665a94;
  background: #e8e3f6;
}

.tag-amber {
  color: #90674e;
  background: #f5eadf;
}

.tag-teal {
  color: #4f7b72;
  background: #e0efe9;
}

.tag-gold {
  color: #8a7a4a;
  background: #f3edd8;
}

.tag-deep {
  color: #4f6a8b;
  background: #dfe8f5;
}

.tag-green {
  color: #4f8b67;
  background: #ddefe4;
}

.tag-blue-light {
  color: #6f879f;
  background: #e6edf5;
}

.tag-priority {
  color: #12598f;
  background: #eaf2fb;
}

.status {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  border: 3rpx solid #c9dde7;
  color: #c9dde7;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
  box-sizing: border-box;
  transform: translateY(2rpx);
}

.status-done {
  border-color: #2f719c;
  color: #2f719c;
}

.report-card {
  margin-top: 24rpx;
  border-radius: 28rpx;
  padding: 30rpx 30rpx;
  background: rgba(205, 222, 239, 0.5);
  border: 2rpx solid rgba(174, 198, 219, 0.35);
  position: relative;
  min-height: 124rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.section-divider {
  height: 2rpx;
  background: #e2eaf7;
  margin: 2rpx 0 12rpx;
}

.report-title {
  color: #204867;
  font-size: 44rpx;
  font-weight: 700;
}

.report-sub {
  margin-top: 12rpx;
  color: #7f92a6;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
  padding: 0 26rpx;
  box-sizing: border-box;
}

.report-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #2e628b;
  font-size: 40rpx;
}
