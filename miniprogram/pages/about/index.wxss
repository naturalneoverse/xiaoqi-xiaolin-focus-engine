page {
  background: #eff7fd;
}

.page {
  min-height: 100vh;
  padding: 20rpx 22rpx 56rpx;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  height: 72rpx;
}

.back-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 96rpx;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.page-title {
  color: #184061;
  font-size: 34rpx;
  font-weight: 700;
}

.top-space {
  min-width: 96rpx;
  text-align: right;
  color: #184061;
  font-size: 30rpx;
  font-weight: 700;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.logo {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-image {
  width: 92rpx;
  height: 92rpx;
}

.name {
  margin-top: 14rpx;
  font-size: 32rpx;
  color: #184061;
  font-weight: 700;
}

.version {
  margin-top: 6rpx;
  color: #8a9cb0;
  font-size: 23rpx;
}

.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 30rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  margin-left: 20px;
  margin-right: 20px;
}

.story-card,
.keepers-card,
.philo-card,
.contact-card,
.dev-card {
  padding: 22rpx;
}


.story-card,
.keepers-card,
.philo-card,
.contact-card {
  margin-bottom: 30px;
}

.title {
  display: block;
  font-size: 34rpx;
  color: #184061;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.p {
  display: block;
  font-size: 27rpx;
  line-height: 1.85;
  color: #577388;
  margin-bottom: 12rpx;
}

.line {
  height: 2rpx;
  background: #e1e5ea;
  margin: 4rpx 0 12rpx;
}

.keepers-card .title {
  font-size: 16px;
  color: #184061;
  font-weight: 500;
}

.keepers-card .line {
  height: 0.5px;
  background: #e1e5ea;
}

.keeper-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 0;
}

.keeper-item + .keeper-item {
  margin-top: 20px;
}

.keeper-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 999rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.keeper-main {
  flex: 1;
}

.keeper-avatar-image {
  width: 100%;
  height: 100%;
  transform: scale(1.18);
}

.keeper-avatar-image-right {
  transform: scaleX(-1);
}

.keeper-name {
  display: block;
  color: #184061;
  font-size: 15px;
  font-weight: 500;
}

.keeper-desc {
  display: block;
  margin-top: 6rpx;
  color: #577388;
  font-size: 13px;
  line-height: 1.6;
}

.philo-item {
  margin-top: 12rpx;
}

.philo-name {
  display: block;
  color: #184061;
  font-size: 14px;
  font-weight: 500;
}

.philo-desc {
  display: block;
  margin-top: 4rpx;
  color: #577388;
  font-size: 13px;
  line-height: 1.6;
}

.kv-row {
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kv-key {
  color: #577388;
  font-size: 26rpx;
}

.kv-value {
  color: #577388;
  font-size: 26rpx;
}

.dev-card {
  text-align: center;
}

.dev-name {
  display: block;
  color: #184061;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.dev-item {
  display: block;
  margin-top: 8rpx;
  color: #577388;
  font-size: 24rpx;
}

.footer {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.footer-main {
  color: #9cb2c8;
  font-size: 20rpx;
}

.footer-sub {
  color: #bfd0df;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}
