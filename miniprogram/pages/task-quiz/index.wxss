@import "../../styles/quiz-common.wxss";

.page--quiz-multi {
  height: 100vh;
  min-height: 100vh;
  justify-content: flex-start;
  padding-top: 16rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.quiz-scroll {
  flex: 1;
  width: 100%;
  height: calc(100vh - 320rpx - env(safe-area-inset-bottom));
  min-height: 400rpx;
}

.quiz-stack {
  padding-bottom: 8rpx;
}

.quiz-card {
  margin-bottom: 24rpx;
}

.quiz-card:last-child {
  margin-bottom: 8rpx;
}

.companion-card {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  border: 2rpx solid rgba(18, 89, 143, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(18, 89, 143, 0.06);
}

.companion-label {
  display: block;
  font-size: 24rpx;
  color: #8a9cb0;
  margin-bottom: 12rpx;
}

.companion-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #334d62;
  font-weight: 400;
}

.companion-code {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a9cb0;
}

.insight-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(225, 229, 234, 0.9);
}

.insight-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #12598f;
  font-style: italic;
}

.btn-insight {
  margin-top: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  background: #fff;
  color: #12598f;
  border: 2rpx solid #b7d6ea;
}

.btn-insight::after {
  border: none;
}

.actions--quiz {
  margin-top: 16rpx;
}

.btn[disabled] {
  opacity: 0.55;
}
