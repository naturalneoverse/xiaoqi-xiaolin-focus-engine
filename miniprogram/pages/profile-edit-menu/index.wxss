@import "../settings/index.wxss";

.cell-avatar-row {
  position: relative;
}

.cell-avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent !important;
  opacity: 0;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  line-height: normal;
  font-size: 0;
}

.cell-avatar-hit::before,
.cell-avatar-hit::after {
  display: none !important;
  border: none !important;
  content: none !important;
}
