<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="card">
    <view class="title-row">
      <view class="title-main">
        <image class="title-icon" src="/images/transparent background/important.png" mode="aspectFit" />
        <text class="title">轻重缓急？</text>
      </view>
      <text class="step">1/3</text>
    </view>
    <view class="list">
      <view
        wx:for="{{options}}"
        wx:key="key"
        class="item {{selected === item.key ? 'item-selected' : ''}}"
        data-key="{{item.key}}"
        bindtap="chooseOption"
      >
        <view>
          <text class="item-title">{{item.key}}</text>
          <text class="item-desc">{{item.desc}}</text>
        </view>
        <text class="mark">{{selected === item.key ? "✓" : "○"}}</text>
      </view>
    </view>
  </view>

  <view class="tip">
    先判断轻重缓急，再安排精力分配，任务会更清晰。
  </view>

  <view class="actions">
    <button class="btn btn-light" bindtap="goPrev">上一步</button>
    <button class="btn" bindtap="goNext">下一页</button>
  </view>

  <view class="progress">
    <view class="dot dot-active"></view>
    <view class="dot"></view>
    <view class="dot"></view>
  </view>
</view>
