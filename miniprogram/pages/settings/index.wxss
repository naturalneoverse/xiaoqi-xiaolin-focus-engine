page {
  background: #e2eaf7;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.top-bar {
  position: relative;
  z-index: 100;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.back-wrap,
.top-space {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 30rpx;
  height: 30rpx;
}

.page-title {
  font-size: 34rpx;
  color: #1f476a;
  font-weight: 600;
}

.group {
  position: relative;
  z-index: 1;
  margin-top: 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
}

/* 避免与 top-bar 的 margin-bottom 叠成一条缝；相邻卡片间距单独拉大，防止「修改资料」贴上提醒卡片 */
.top-bar + .group {
  margin-top: 24rpx;
}

.group + .group {
  margin-top: 32rpx;
}

.cell {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 双行标题时与 switch 对齐；裁掉 scale 后溢出，避免热区顶到自定义导航、挡关闭键 */
.cell-switch-row {
  align-items: flex-start;
  overflow: hidden;
}

/* 限制 switch 热区，避免在真机上「压住」下一行「修改资料」导致点击失灵 */
.switch-hit-clip {
  flex-shrink: 0;
  width: 112rpx;
  height: 64rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.cell-hover {
  opacity: 0.92;
}

.cell-left {
  display: flex;
  flex-direction: column;
}

.cell-title {
  font-size: 32rpx;
  color: #334155;
}

.cell-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8ea1b6;
}

.line {
  height: 2rpx;
  background: #e2eaf7;
}

.arrow {
  color: #7f93a9;
  font-size: 36rpx;
}

.version {
  color: #8ea1b6;
  font-size: 28rpx;
}

.notify-switch {
  transform: scale(0.8);
  transform-origin: right center;
}
