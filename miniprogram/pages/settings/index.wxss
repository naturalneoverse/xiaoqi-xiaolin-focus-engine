page {
  background: #e2eaf7;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.top-bar {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.back-wrap,
.top-space {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 30rpx;
  height: 30rpx;
}

.page-title {
  font-size: 34rpx;
  color: #1f476a;
  font-weight: 600;
}

.group {
  margin-top: 24rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 0 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 64, 97, 0.06);
}

.cell {
  min-height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cell-left {
  display: flex;
  flex-direction: column;
}

.cell-title {
  font-size: 32rpx;
  color: #334155;
}

.cell-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8ea1b6;
}

.line {
  height: 2rpx;
  background: #e2eaf7;
}

.arrow {
  color: #7f93a9;
  font-size: 36rpx;
}

.version {
  color: #8ea1b6;
  font-size: 28rpx;
}
