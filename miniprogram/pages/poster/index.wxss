page {
  background: #f0f4f8;
}

.page {
  min-height: 100vh;
  padding: 18rpx 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 700rpx;
  margin-bottom: 16rpx;
}

.nav-btn {
  width: 76rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(184, 197, 211, 0.55);
  background: rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.nav-title {
  flex: 1;
  text-align: center;
  color: #184061;
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-space {
  width: 76rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.loading-wrap {
  width: 100%;
  max-width: 700rpx;
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 30rpx;
  color: #577388;
}

.preview-wrap {
  width: 100%;
  max-width: 700rpx;
  border-radius: 24rpx;
  overflow: hidden;
  /* 避免透明 PNG 在预览里被衬成「白边」误判为导出故障 */
  background: transparent;
  box-shadow: 0 8rpx 32rpx rgba(24, 64, 97, 0.08);
}

.preview-img {
  width: 100%;
  display: block;
  vertical-align: top;
}

.poster-canvas-offscreen {
  position: fixed;
  left: -3000px;
  top: 0;
  width: 1080px;
  height: 1920px;
  background: transparent;
}

.poster-logo-work {
  position: fixed;
  left: -4000px;
  top: 0;
  width: 256px;
  height: 256px;
}

.toolbar.grid {
  width: 100%;
  max-width: 700rpx;
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
}

.tool-cell {
  margin: 0;
  padding: 0 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #2c3e50;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: none;
}

.tool-cell::after {
  border: none;
}

.tool-cell.tool-primary {
  background: #184061;
  color: #f5f9fc;
}

.tool-cell[disabled] {
  opacity: 0.45;
}
