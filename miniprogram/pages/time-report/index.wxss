page {
  background: linear-gradient(180deg, #eff7fd 0%, #d6ebf7 100%);
}

.page {
  min-height: 100vh;
  padding: 18rpx 24rpx 36rpx;
  box-sizing: border-box;
}

.top-bar {
  height: 74rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.back-wrap {
  width: 126rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.page-title {
  color: #184061;
  font-size: 48rpx;
  font-weight: 700;
}

.top-space {
  width: 126rpx;
  height: 56rpx;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.card {
  background: rgba(255, 255, 255, 0.93);
  border-radius: 30rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(24, 64, 97, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  color: #184061;
  font-size: 35rpx;
  font-weight: 700;
}

.card-range {
  color: #8a9cb0;
  font-size: 25rpx;
}

.latest-body {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-right: 18rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-value-wrap {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 2rpx;
}

.metric-value {
  color: #184061;
  font-size: 58rpx;
  font-weight: 700;
}

.metric-unit {
  color: #8a9cb0;
  font-size: 24rpx;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: #8a9cb0;
  font-size: 24rpx;
}

.metric-status {
  display: block;
  margin-top: 2rpx;
  color: #184061;
  font-size: 48rpx;
  font-weight: 700;
}

.metric-divider {
  width: 1rpx;
  height: 74rpx;
  background: rgba(225, 229, 234, 0.7);
}

.chevron {
  position: absolute;
  right: -2rpx;
  top: 50%;
  transform: translateY(-54%);
  color: #8a9cb0;
  font-size: 40rpx;
}

.card-title-history {
  margin-bottom: 14rpx;
}

.line {
  width: 100%;
  height: 1rpx;
  background: #e1e5ea;
}

.history-row {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-row-border {
  border-bottom: 1rpx solid rgba(225, 229, 234, 0.6);
}

.history-left {
  color: #184061;
  font-size: 30rpx;
}

.history-right-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-right {
  color: #577388;
  font-size: 28rpx;
}

.history-arrow {
  color: #8a9cb0;
  font-size: 40rpx;
  line-height: 1;
}

.past-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.past-subtitle {
  color: #8a9cb0;
  font-size: 24rpx;
}

.past-group {
  margin-top: 12rpx;
}

.group-title-row {
  height: 62rpx;
  display: flex;
  align-items: center;
}

.group-arrow {
  color: #184061;
  font-size: 30rpx;
  width: 30rpx;
}

.group-range {
  color: #184061;
  font-size: 31rpx;
  font-weight: 700;
}

.task-items {
  margin-top: 6rpx;
  padding-left: 30rpx;
}

.task-item-row {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-item-name {
  color: #577388;
  font-size: 30rpx;
}

.task-item-tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e7f6f1;
  color: #008a5e;
  font-size: 24rpx;
}

.row-hover {
  opacity: 0.85;
}
