@import "../../styles/reflection-page.wxss";

.list-page {
  height: 100vh;
  box-sizing: border-box;
}

.list-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
}

.list-empty {
  margin-top: 160rpx;
  padding: 0 32rpx;
  text-align: center;
}

.list-empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
}

.list-empty-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.55;
}

.list-section {
  margin-bottom: 8rpx;
}

.list-section-title {
  display: block;
  padding: 8rpx 4rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #577388;
  line-height: 1.4;
}

.list-section .list-card:last-child {
  margin-bottom: 28rpx;
}

.list-card {
  margin-bottom: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.list-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.list-task-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
}

.list-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #8a9cb0;
  line-height: 1.2;
}

.list-time {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.4;
}

.list-progress {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #2a6a9a;
  line-height: 1.4;
}

.row-hover {
  opacity: 0.92;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.35;
  background: rgba(255, 255, 255, 0.55);
}

.list-foot-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
