<view class="page reflection-page list-page" style="{{_globalSafeAreaStyle}}">
  <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <block wx:if="{{empty}}">
      <view class="list-empty">
        <text class="list-empty-title">还没有复盘记录</text>
        <text class="list-empty-desc">在任务详情中开始哲思复盘，记录会出现在这里</text>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{sections}}" wx:key="sectionKey" class="list-section">
        <text class="list-section-title">{{item.title}}</text>
        <view
          wx:for="{{item.items}}"
          wx:for-item="card"
          wx:key="taskId"
          class="list-card tap-target"
          bindtap="onTapRecord"
          bindlongpress="onRecordLongPress"
          data-task-id="{{card.taskId}}"
          data-task-title="{{card.taskTitle}}"
          hover-class="row-hover"
        >
          <view class="list-card-head">
            <text class="list-task-title">{{card.taskTitle}}</text>
            <text class="list-arrow">›</text>
          </view>
          <text wx:if="{{card.cardTime || card.reportTime}}" class="list-time">{{card.cardTime || card.reportTime}}</text>
          <text wx:if="{{card.progressLabel}}" class="list-progress">{{card.progressLabel}}</text>
          <view wx:if="{{card.tags.length}}" class="tag-row">
            <text
              wx:for="{{card.tags}}"
              wx:for-item="tag"
              wx:key="id"
              class="tag-pill"
              style="color: {{tag.accent}}; border-color: {{tag.accent}};"
            >{{tag.title}}</text>
          </view>
        </view>
      </view>
    </block>
    <view class="list-foot-space"></view>
  </scroll-view>
</view>
