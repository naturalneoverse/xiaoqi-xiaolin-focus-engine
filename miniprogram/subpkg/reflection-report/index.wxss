@import "../../styles/reflection-page.wxss";

.report-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.report-scroll {
  flex: 1;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.report-head {
  padding: 32rpx 40rpx 8rpx;
  box-sizing: border-box;
  text-align: center;
}

.report-task-name {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.45;
}

.report-time {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.4;
}

.report-combo {
  margin: 8rpx 40rpx 0;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.report-combo--intro {
  margin-top: 16rpx;
}

.report-donut-wrap {
  display: block;
  width: 100%;
  margin-top: 8rpx;
}

.report-restart-wrap {
  margin: 28rpx 40rpx 8rpx;
  padding: 16rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.report-restart-btn {
  flex: 0 0 auto;
  display: block;
  padding: 20rpx 40rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  line-height: 1.45;
  font-size: 28rpx;
  font-weight: 500;
  color: #12598f;
  background: transparent;
  border: none;
  border-radius: 999rpx;
  opacity: 0.96;
}

.report-restart-btn::after {
  display: none;
  border: none;
}

.report-restart-btn-hover {
  opacity: 0.72;
}

.report-combo--outro {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.report-combo-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #577388;
  line-height: 1.55;
  letter-spacing: 0.02em;
}

.report-combo-text--outro {
  font-size: 26rpx;
  font-weight: 400;
  color: #8a9cb0;
}

.report-section {
  margin: 24rpx 32rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.report-section--filled {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.section-head {
  padding: 28rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.35;
}

.section-agent {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #8a9cb0;
  opacity: 0.85;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #577388;
  line-height: 1.4;
}

.section-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.35;
}

.section-body {
  padding: 0 28rpx 28rpx;
  box-sizing: border-box;
}

.section-empty {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.5;
}

.echo-para-wrap + .echo-para-wrap {
  margin-top: 20rpx;
}

.echo-para {
  display: block;
  font-size: 28rpx;
  font-weight: 400;
  color: #2a4a62;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-word;
  text-align: justify;
}

.report-section--closing {
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.55) 0%,
    rgba(239, 247, 253, 0.85) 100%
  ) !important;
}

.section-title--closing {
  color: #12598f !important;
}

.echo-para--closing {
  color: #334d62;
}

.report-foot-space {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.report-footer {
  flex-shrink: 0;
  position: relative;
  z-index: 20;
  padding: 16rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(239, 247, 253, 0) 0%, rgba(239, 247, 253, 0.92) 24%);
}

.report-save-btn {
  width: 100%;
  max-width: 700rpx;
  margin: 0 auto;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: #12598f !important;
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 500;
  border: none !important;
  padding: 0 !important;
}

.report-save-btn::after {
  display: none !important;
  border: none !important;
}

.report-save-btn-hover {
  background: #0e4a75 !important;
  opacity: 0.96;
}

.report-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
  opacity: 0;
  pointer-events: none;
}
