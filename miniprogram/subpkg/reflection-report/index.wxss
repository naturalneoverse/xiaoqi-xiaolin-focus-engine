@import "../../styles/reflection-page.wxss";

/* 复盘报告正文字号 ×1.2（仅 .report-page 内生效） */
.report-page {
  --reflection-report-font-title: 43rpx;
  --reflection-report-font-sub: 31rpx;
  --reflection-report-font-body: 34rpx;
  --reflection-report-font-meta: 26rpx;
  --reflection-report-font-combo: 34rpx;
  --reflection-empty-label-size: 34rpx;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.report-scroll {
  flex: 1;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.report-head {
  padding: 32rpx 40rpx 8rpx;
  box-sizing: border-box;
  text-align: center;
}

.report-task-name {
  display: block;
  font-size: 41rpx;
  font-weight: 500;
  color: #184061;
  line-height: var(--reflection-report-line-title);
}

.report-time {
  display: block;
  margin-top: 12rpx;
  font-size: var(--reflection-report-font-meta);
  font-weight: 400;
  color: var(--reflection-empty-label-color);
  line-height: var(--reflection-report-line-sub);
}

.report-pending-hint {
  margin: 16rpx 32rpx 0;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(24, 64, 97, 0.12);
  box-sizing: border-box;
}

.report-pending-hint-text {
  display: block;
  font-size: 31rpx;
  line-height: 1.5;
  color: #3d5f7a;
}

.report-combo {
  margin: 8rpx 40rpx 0;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.report-combo--intro {
  margin-top: 16rpx;
}

.report-donut-wrap {
  display: block;
  width: 100%;
  margin-top: 8rpx;
}

.report-combo--outro {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.report-combo-text {
  display: block;
  text-align: center;
  font-size: var(--reflection-report-font-combo);
  font-weight: 500;
  color: #577388;
  line-height: var(--reflection-report-line-combo);
  letter-spacing: 0.02em;
}

.report-combo-text--outro {
  font-size: var(--reflection-report-font-sub);
  font-weight: 400;
  color: var(--reflection-empty-label-color);
}

.report-section {
  margin: var(--reflection-report-section-gap) var(--reflection-report-section-margin-h) 0;
  border-radius: var(--reflection-report-section-radius);
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, var(--reflection-card-border-alpha));
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.report-section--filled {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.section-head {
  padding: 28rpx 28rpx 16rpx;
  box-sizing: border-box;
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  flex: 1;
  font-size: var(--reflection-report-font-title);
  font-weight: 500;
  line-height: var(--reflection-report-line-title);
}

.section-agent {
  flex-shrink: 0;
  font-size: var(--reflection-report-font-meta);
  font-weight: 400;
  color: var(--reflection-empty-label-color);
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--reflection-report-font-sub);
  font-weight: 400;
  color: #577388;
  line-height: var(--reflection-report-line-sub);
}

.section-time {
  display: block;
  margin-top: 10rpx;
  font-size: var(--reflection-report-font-meta);
  font-weight: 400;
  color: var(--reflection-empty-label-color);
  line-height: var(--reflection-report-line-sub);
}

.section-body {
  padding: 0 28rpx 28rpx;
  box-sizing: border-box;
}

.section-empty {
  display: block;
  font-size: var(--reflection-empty-label-size);
  font-weight: 400;
  color: var(--reflection-empty-label-color);
  line-height: var(--reflection-empty-label-line);
}

.echo-para-wrap + .echo-para-wrap {
  margin-top: var(--reflection-report-para-gap);
}

.echo-para {
  display: block;
  font-size: var(--reflection-report-font-body);
  font-weight: 400;
  color: #2a4a62;
  line-height: var(--reflection-report-line-body);
  white-space: pre-wrap;
  word-break: break-word;
  text-align: justify;
}

.report-section--closing {
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, var(--reflection-card-alpha)) 0%,
    rgba(239, 247, 253, 0.92) 100%
  ) !important;
}

.section-title--closing {
  color: #12598f !important;
}

.echo-para--closing {
  font-size: var(--reflection-report-font-body);
  line-height: var(--reflection-report-line-body);
  color: #334d62;
}

.report-foot-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.report-loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(239, 247, 253, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-loading-panel {
  padding: 36rpx 40rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  min-width: 320rpx;
  box-sizing: border-box;
}

.report-loading-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: rgba(183, 214, 234, 0.5);
}

.report-loading-line--lg {
  width: 100%;
}

.report-loading-line--md {
  width: 72%;
}

.report-loading-text {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: var(--reflection-report-font-sub);
  color: #6a8298;
  line-height: var(--reflection-report-line-sub);
}
