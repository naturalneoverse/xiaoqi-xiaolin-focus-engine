<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="range-wrap">
    <text class="range-text">{{rangeText}}</text>
    <text wx:if="{{layoutFixtureBanner}}" class="layout-fixture-banner">{{layoutFixtureBanner}}</text>
  </view>

  <view class="main-card">
    <view class="section">
      <text class="section-title">本周回顾</text>
      <text class="section-desc">{{reviewText}}</text>
    </view>

    <view class="group">
      <view class="group-title-row">
        <image class="group-icon-image" src="/images/transparent background/sleep.png" mode="aspectFit" binderror="onImageError" />
        <text class="group-title">睡眠</text>
      </view>
      <view class="grid-two">
        <view class="mini-item" wx:for="{{sleepStats}}" wx:key="label">
          <view class="mini-row"><text>{{item.label}}</text><text>{{item.percentText}}</text></view>
          <view class="bar"><view class="fill" style="{{item.widthStyle}}"></view></view>
        </view>
      </view>
      <text wx:if="{{sleepNarrative}}" class="dim-narrative">{{sleepNarrative}}</text>
    </view>

    <view class="group">
      <view class="group-title-row">
        <image class="group-icon-image" src="/images/transparent background/sport.png" mode="aspectFit" binderror="onImageError" />
        <text class="group-title">运动</text>
      </view>
      <view class="grid-two">
        <view class="mini-item" wx:for="{{sportStats}}" wx:key="label">
          <view class="mini-row"><text>{{item.label}}</text><text>{{item.percentText}}</text></view>
          <view class="bar"><view class="fill" style="{{item.widthStyle}}"></view></view>
        </view>
      </view>
      <text wx:if="{{sportNarrative}}" class="dim-narrative">{{sportNarrative}}</text>
    </view>

    <view class="group">
      <view class="group-title-row">
        <image class="group-icon-image" src="/images/transparent background/singnal.png" mode="aspectFit" binderror="onImageError" />
        <text class="group-title">身体信号</text>
      </view>
      <view class="grid-two">
        <view class="mini-item" wx:for="{{signalStats}}" wx:key="label">
          <view class="mini-row"><text>{{item.label}}</text><text>{{item.percentText}}</text></view>
          <view class="bar"><view class="fill" style="{{item.widthStyle}}"></view></view>
        </view>
      </view>
      <text wx:if="{{signalNarrative}}" class="dim-narrative">{{signalNarrative}}</text>
    </view>

    <view class="status-card">
      <view class="status-left">
        <text class="status-label">本周状态</text>
        <view class="status-title-row">
          <text class="status-title">{{statusTitle}}</text>
          <image class="status-icon-image" src="{{statusIcon}}" mode="aspectFit" binderror="onImageError" />
        </view>
        <text class="status-desc">{{statusDesc}}</text>
        <text wx:if="{{extremeLine}}" class="extreme-line">{{extremeLine}}</text>
      </view>
    </view>

    <view class="ai-card">
      <view class="ai-avatar">
        <view class="mascot-float-3d ai-avatar-float {{mascotAnimPaused ? 'mascot-float-paused' : ''}}">
          <image class="ai-avatar-image mascot-float-img" src="/images/transparent background/xiaolin.png" mode="aspectFit" binderror="onImageError" />
        </view>
      </view>
      <view class="ai-bubble-wrap">
        <text wx:if="{{careLoading}}" class="care-loading-hint">小麟正在写本周回响…</text>
        <chat-bubble
          text="{{careText}}"
          color="#b7d6ea"
          arrowPosition="left"
          maxLength="{{200}}"
        />
      </view>
    </view>

    <view class="quote-list">
      <view class="quote-item">
        <view class="quote-body">
          <text class="quote-title">累到不行的时候，你才想起来自己还有个身体.</text>
          <text class="quote-sub">—雅斯贝尔斯说，人在身体的极限处，才真正意识到自己活着.</text>
        </view>
      </view>
      <view class="quote-item">
        <view class="quote-body">
          <text class="quote-title">疼了知道停，累了知道歇，好了知道珍惜.</text>
          <text class="quote-sub">—身体从不撒谎，它的信号就是边界.</text>
        </view>
      </view>
      <view class="quote-item">
        <view class="quote-body">
          <text class="quote-title">对自己好一点，不是口号，是练习.</text>
          <text class="quote-sub">—边界不是限制，是保护。不是束缚，是自由.</text>
        </view>
      </view>
    </view>

    <view class="back-btn tap-target" bindtap="goHome" hover-class="row-hover">
      <text class="back-btn-text">返回身心页面</text>
    </view>
  </view>
</view>
