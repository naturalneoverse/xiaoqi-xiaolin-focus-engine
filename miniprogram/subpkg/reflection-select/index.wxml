<view class="page reflection-page" style="{{_globalSafeAreaStyle}}">
  <view class="select-body">
    <view class="select-main">
      <text wx:if="{{taskTitle}}" class="task-name">{{taskTitle}}</text>

      <view class="quadrant-grid">
        <view
          wx:for="{{quadrants}}"
          wx:key="id"
          class="quadrant-card tap-target {{item.completed ? 'quadrant-card--completed' : ''}}"
          style="background: {{item.bg}};"
          bindtap="onTapQuadrant"
          data-id="{{item.id}}"
        >
          <view class="quadrant-card-inner">
            <text class="q-title">{{item.title}}</text>
            <text class="q-sub">{{item.sub1}}</text>
            <text class="q-sub">{{item.sub2}}</text>
            <text class="q-agent">{{item.agent}}</text>
          </view>
        </view>
      </view>

      <text class="guide">选一个你最想开始的方向</text>
    </view>

    <view class="select-footer">
      <view wx:if="{{showStatusGenerating}}" class="select-status select-status--generating">
        <text class="select-status-text">部分手写解读正在生成（约 1～3 分钟），您可先填其它象限</text>
      </view>

      <view wx:if="{{showStatusReady}}" class="select-status select-status--ready">
        <text class="select-status-text">您的回响已更新，请点击下方查看报告</text>
        <view class="select-ready-cue" aria-hidden="true">
          <view class="select-ready-dot"></view>
          <view class="select-ready-arrow"></view>
        </view>
      </view>

      <view wx:if="{{showReportEntry}}" class="report-entry tap-target" bindtap="onTapReport">
        <text class="report-entry-text">查看复盘报告</text>
      </view>
    </view>
  </view>
</view>
