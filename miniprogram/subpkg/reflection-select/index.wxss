@import "../../styles/reflection-page.wxss";

.select-body {
  min-height: 100vh;
  padding: 32rpx 40rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.select-main {
  flex: 0 0 auto;
}

.select-footer {
  flex-shrink: 0;
  margin-top: 32rpx;
  padding-top: 0;
}

.task-name {
  display: block;
  margin-bottom: 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.4;
}

.quadrant-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quadrant-card {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  border-radius: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, var(--reflection-card-border-alpha));
  transition: background 0.25s ease, filter 0.25s ease;
}

/* 已提交：略加深阴影，饱和度由 theme 渐变 ×4 负责 */
.quadrant-card--completed {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.quadrant-card-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.q-title {
  display: block;
  width: 100%;
  font-size: 45rpx;
  font-weight: 500;
  color: #184061;
  line-height: 1.3;
}

.q-sub {
  display: block;
  width: 100%;
  font-size: 30rpx;
  font-weight: 400;
  color: #577388;
  line-height: 1.35;
}

.q-title + .q-sub {
  margin-top: 59rpx;
}

.q-sub + .q-sub {
  margin-top: 0;
}

.q-agent {
  display: block;
  width: 100%;
  margin-top: 41rpx;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.35;
  color: #8a9cb0;
  opacity: 0.7;
}

.guide {
  display: block;
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 400;
  color: #8a9cb0;
  line-height: 1.5;
}

.select-status {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  box-sizing: border-box;
}

.select-status--generating {
  background: rgba(24, 74, 114, 0.06);
}

.select-status--ready {
  background: rgba(18, 89, 143, 0.08);
}

.select-status-text {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #577388;
  line-height: 1.55;
}

.select-status--ready .select-status-text {
  color: #184061;
}

/* 就绪：圆点 + 向下三角（纯 CSS，不占 images 体积） */
.select-ready-cue {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 12rpx;
  animation: select-ready-cue-nudge 1.05s ease-in-out 3;
  animation-fill-mode: forwards;
}

.select-ready-dot {
  width: 12rpx;
  height: 12rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background: #12598f;
}

.select-ready-arrow {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 18rpx solid #12598f;
}

@keyframes select-ready-cue-nudge {
  0%,
  100% {
    transform: translateY(0);
    opacity: 1;
  }
  50% {
    transform: translateY(14rpx);
    opacity: 0.55;
  }
}

.report-entry {
  margin-top: 8rpx;
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.report-entry-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #12598f;
  line-height: 1.4;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}
