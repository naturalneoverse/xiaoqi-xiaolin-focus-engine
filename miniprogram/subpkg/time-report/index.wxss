page {
  background-color: #eff7fd;
}

.page {
  min-height: 100vh;
  padding: 18rpx 24rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eff7fd 0%, #d6ebf7 100%);
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.time-report-main {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.top-bar {
  height: 74rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.back-wrap {
  width: 126rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.page-title {
  flex: 1;
  text-align: center;
  color: #184061;
  font-size: 32rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-space {
  width: 126rpx;
  height: 56rpx;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.card {
  background: #ffffff;
  border-radius: 30rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(24, 64, 97, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  color: #184061;
  font-size: 35rpx;
  font-weight: 700;
}

.card-range {
  color: #8a9cb0;
  font-size: 25rpx;
}

.latest-body {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-right: 18rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-value-wrap {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 2rpx;
}

.metric-value {
  color: #184061;
  font-size: 58rpx;
  font-weight: 700;
}

.metric-unit {
  color: #8a9cb0;
  font-size: 24rpx;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: #8a9cb0;
  font-size: 24rpx;
}

.metric-status {
  display: block;
  margin-top: 2rpx;
  color: #184061;
  font-size: 48rpx;
  font-weight: 700;
}

.metric-status-muted {
  color: #8a9cb0;
  font-size: 40rpx;
}

.presence-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  padding: 0 12rpx;
  color: #577388;
  font-size: 24rpx;
  line-height: 1.5;
}

.metric-divider {
  width: 1rpx;
  height: 74rpx;
  background: rgba(225, 229, 234, 0.7);
}

.chevron {
  position: absolute;
  right: -2rpx;
  top: 50%;
  transform: translateY(-54%);
  color: #8a9cb0;
  font-size: 40rpx;
}

.card-title-history {
  margin-bottom: 14rpx;
}

.line {
  width: 100%;
  height: 1rpx;
  background: #e1e5ea;
}

.history-row {
  min-height: 92rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-empty {
  padding: 20rpx 0 8rpx;
}

.history-empty-text {
  color: #8a9cb0;
  font-size: 28rpx;
  line-height: 1.5;
}

.history-more-row {
  margin-top: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(225, 229, 234, 0.6);
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-more-text {
  color: #2a6a9a;
  font-size: 30rpx;
  font-weight: 500;
}

.history-left {
  color: #184061;
  font-size: 30rpx;
}

.history-right-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-right-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.history-right {
  color: #577388;
  font-size: 28rpx;
}

.history-presence {
  color: #577388;
  font-size: 24rpx;
}

.history-arrow {
  color: #8a9cb0;
  font-size: 40rpx;
  line-height: 1;
}

.past-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.past-subtitle {
  color: #8a9cb0;
  font-size: 24rpx;
}

.past-group {
  margin-top: 12rpx;
}

.past-empty-text {
  display: block;
  padding: 18rpx 0 8rpx;
  color: #8a9cb0;
  font-size: 28rpx;
}

.group-title-row {
  min-height: 68rpx;
  padding: 8rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.group-range {
  color: #184061;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  flex: 1;
  min-width: 0;
}

.group-chevron {
  color: #8a9cb0;
  font-size: 34rpx;
  flex-shrink: 0;
  width: 34rpx;
  text-align: right;
  line-height: 1;
}

.past-task-cards {
  margin: 0 0 14rpx;
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
  background: #edf4fc;
  border: 1rpx solid rgba(186, 204, 224, 0.45);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.88),
    0 4rpx 16rpx rgba(24, 64, 97, 0.05);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.past-task-card {
  background: #ffffff;
  border-radius: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  padding: 18rpx 20rpx 16rpx;
  box-shadow:
    0 2rpx 6rpx rgba(24, 64, 97, 0.05),
    0 8rpx 22rpx rgba(24, 64, 97, 0.07);
  box-sizing: border-box;
}

.past-task-card-hover {
  background: #f8fbfe;
  transform: translateY(-1rpx);
  box-shadow:
    0 4rpx 10rpx rgba(24, 64, 97, 0.07),
    0 12rpx 28rpx rgba(24, 64, 97, 0.08);
}

.past-task-card-title {
  display: block;
  color: #184061;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.past-task-card-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
}

.past-task-card-tags {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.past-task-tag {
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #72869f;
  background: #e7eef6;
}

.past-task-tag-muted {
  background: transparent;
  color: #b0bec9;
}

.past-task-tag.tag-red {
  color: #8e4f57;
  background: #f1dfe3;
}

.past-task-tag.tag-orange {
  color: #a5673f;
  background: #f7e4d6;
}

.past-task-tag.tag-gray {
  color: #66758b;
  background: #e3e8f0;
}

.past-task-tag.tag-blue {
  color: #4a78a2;
  background: #ddeaf7;
}

.past-task-tag.tag-berry {
  color: #8c566a;
  background: #f1e2e8;
}

.past-task-tag.tag-lavender {
  color: #6f689b;
  background: #ebe8f8;
}

.past-task-tag.tag-sky {
  color: #567fa3;
  background: #e2eef8;
}

.past-task-tag.tag-violet {
  color: #665a94;
  background: #e8e3f6;
}

.past-task-tag.tag-amber {
  color: #90674e;
  background: #f5eadf;
}

.past-task-tag.tag-teal {
  color: #4f7b72;
  background: #e0efe9;
}

.past-task-tag.tag-gold {
  color: #8a7a4a;
  background: #f3edd8;
}

.past-task-tag.tag-deep {
  color: #4f6a8b;
  background: #dfe8f5;
}

.past-task-card-arrow {
  color: #8a9cb0;
  font-size: 34rpx;
  flex-shrink: 0;
  line-height: 1;
}

.past-dates-toggle {
  margin-top: 4rpx;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.past-dates-toggle-text {
  color: #2a6a9a;
  font-size: 28rpx;
  font-weight: 500;
}

.past-dates-toggle-arrow {
  color: #6f86a0;
  font-size: 24rpx;
}

.row-hover {
  opacity: 0.85;
}

.presence-quote-block {
  flex-shrink: 0;
  text-align: center;
  padding: 28rpx 20rpx 8rpx;
  margin-top: auto;
  width: 100%;
  box-sizing: border-box;
}

.presence-plain {
  display: block;
  color: #577388;
  font-size: 26rpx;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.presence-classic {
  display: block;
  color: #8a9cb0;
  font-size: 22rpx;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.presence-attrib {
  display: block;
  color: #a3b6c8;
  font-size: 22rpx;
}
