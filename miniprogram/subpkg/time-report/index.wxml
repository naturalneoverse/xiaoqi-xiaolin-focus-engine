<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="time-report-main">
  <view class="top-bar">
    <view class="back-wrap tap-target" bindtap="goBack" hover-class="row-hover">
      <image class="close-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <text class="page-title">时间编织图</text>
    <view class="top-space"></view>
  </view>

  <view class="card latest-card" bindtap="goWeeklyFromLatest" hover-class="row-hover">
    <view class="card-head">
      <text class="card-title">最新报告</text>
      <text class="card-range">{{latest.range}}</text>
    </view>

    <view class="latest-body">
      <view class="metric">
        <view class="metric-value-wrap">
          <text class="metric-value">{{latest.moments}}</text>
          <text class="metric-unit">次</text>
        </view>
        <text class="metric-label">真我时刻</text>
      </view>
      <view class="metric-divider"></view>
      <view class="metric">
        <view class="metric-value-wrap">
          <text class="metric-value">{{latest.doneCount}}</text>
          <text class="metric-unit">件</text>
        </view>
        <text class="metric-label">完成任务</text>
      </view>
      <view class="metric-divider"></view>
      <view class="metric">
        <text class="metric-status {{latest.presenceName === '暂无' ? 'metric-status-muted' : ''}}">{{latest.presenceName}}</text>
        <text class="metric-label">当下质地</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <text wx:if="{{latest.presenceHint}}" class="presence-hint">{{latest.presenceHint}}</text>
  </view>

  <view class="card">
    <text class="card-title card-title-history">上周报告</text>
    <view class="line"></view>
    <view
      wx:if="{{lastWeekReport}}"
      class="history-row"
      bindtap="goLastWeekReport"
      hover-class="row-hover"
    >
      <text class="history-left">{{lastWeekReport.range}}</text>
      <view class="history-right-wrap">
        <view class="history-right-col">
          <text class="history-right">真我时刻 {{lastWeekReport.moments}}次</text>
          <text class="history-presence">当下质地 {{lastWeekReport.presenceName}}</text>
        </view>
        <text class="history-arrow">›</text>
      </view>
    </view>
    <view wx:else class="history-empty">
      <text class="history-empty-text">{{lastWeekEmptyHint}}</text>
    </view>
    <view
      wx:if="{{showAllPastLink}}"
      class="history-more-row tap-target"
      bindtap="goAllPastReports"
      hover-class="row-hover"
    >
      <text class="history-more-text">查看全部往期</text>
      <text class="history-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="past-head">
      <text class="card-title">往期任务</text>
      <text class="past-subtitle">已完成的任务</text>
    </view>
    <view class="line"></view>
    <view wx:for="{{pastTaskGroups}}" wx:key="dateKey" class="past-group">
      <view
        wx:if="{{!item.isEmpty}}"
        class="group-title-row tap-target"
        data-date-key="{{item.dateKey}}"
        bindtap="toggleTaskGroup"
        hover-class="row-hover"
      >
        <text class="group-range">{{item.range}}</text>
        <text class="group-chevron">{{item.expanded ? "▾" : "›"}}</text>
      </view>
      <text wx:else class="past-empty-text">{{item.range}}</text>
      <view wx:if="{{item.expanded && !item.isEmpty}}" class="past-task-cards">
        <view
          wx:for="{{item.tasks}}"
          wx:for-item="task"
          wx:key="taskId"
          class="past-task-card tap-target"
          data-task-id="{{task.taskId}}"
          bindtap="goPastTaskDetail"
          hover-class="past-task-card-hover"
        >
          <text class="past-task-card-title">{{task.name}}</text>
          <view class="past-task-card-foot">
            <view class="past-task-card-tags">
              <text
                wx:for="{{task.tags}}"
                wx:for-item="tag"
                wx:key="text"
                class="past-task-tag {{tag.className}}"
              >{{tag.text}}</text>
              <text wx:if="{{!task.tags.length}}" class="past-task-tag past-task-tag-muted">—</text>
            </view>
            <text class="past-task-card-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
    <view
      wx:if="{{showPastDatesExpand}}"
      class="past-dates-toggle tap-target"
      bindtap="togglePastDatesExpand"
      hover-class="row-hover"
    >
      <text class="past-dates-toggle-text">展开更多日期</text>
      <text class="past-dates-toggle-arrow">▾</text>
    </view>
    <view
      wx:if="{{showPastDatesCollapse}}"
      class="past-dates-toggle tap-target"
      bindtap="togglePastDatesExpand"
      hover-class="row-hover"
    >
      <text class="past-dates-toggle-text">收起更早</text>
      <text class="past-dates-toggle-arrow">▴</text>
    </view>
  </view>
  </view>

  <view class="presence-quote-block">
    <text class="presence-plain">时间不是钟表，而是你真正沉浸在此刻的厚度。</text>
    <text class="presence-classic">感知有一个流动的原初自身亲临的点，除此之外还有一个刚才曾是（原滞留）的视域，以及一个即将来临（原前摄）的视域。</text>
    <text class="presence-attrib">—— 胡塞尔</text>
  </view>
</view>
