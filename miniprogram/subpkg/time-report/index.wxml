<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="time-report-main">
  <view class="top-bar">
    <view class="back-wrap tap-target" bindtap="goBack" hover-class="row-hover">
      <image class="close-icon" src="/images/transparent background/close.png" mode="aspectFit" binderror="onImageError" />
    </view>
    <text class="page-title">时间编织图</text>
    <view class="top-space"></view>
  </view>

  <view class="card latest-card" bindtap="goWeeklyFromLatest" hover-class="row-hover">
    <view class="card-head">
      <text class="card-title">最新报告</text>
      <text class="card-range">{{latest.range}}</text>
    </view>

    <view class="latest-body">
      <view class="metric">
        <view class="metric-value-wrap">
          <text class="metric-value">{{latest.moments}}</text>
          <text class="metric-unit">次</text>
        </view>
        <text class="metric-label">真我时刻</text>
      </view>
      <view class="metric-divider"></view>
      <view class="metric">
        <view class="metric-value-wrap">
          <text class="metric-value">{{latest.doneCount}}</text>
          <text class="metric-unit">件</text>
        </view>
        <text class="metric-label">完成任务</text>
      </view>
      <view class="metric-divider"></view>
      <view class="metric">
        <text class="metric-status {{latest.presenceName === '暂无' ? 'metric-status-muted' : ''}}">{{latest.presenceName}}</text>
        <text class="metric-label">当下质地</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <text wx:if="{{latest.presenceHint}}" class="presence-hint">{{latest.presenceHint}}</text>
  </view>

  <view class="card">
    <text class="card-title card-title-history">历史报告</text>
    <view class="line"></view>
    <view
      wx:for="{{historyReports}}"
      wx:key="weekMondayKey"
      class="history-row {{index < historyReports.length - 1 ? 'history-row-border' : ''}}"
      data-index="{{index}}"
      bindtap="goHistoryReport"
      hover-class="row-hover"
    >
      <text class="history-left">{{item.range}}</text>
      <view class="history-right-wrap">
        <view class="history-right-col">
          <text class="history-right">真我时刻 {{item.moments}}次</text>
          <text class="history-presence">当下质地 {{item.presenceName}}</text>
        </view>
        <text class="history-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="past-head">
      <text class="card-title">往期任务</text>
      <text class="past-subtitle">已完成的任务</text>
    </view>
    <view class="line"></view>
    <view wx:for="{{pastTaskGroups}}" wx:key="range" class="past-group">
      <view
        class="group-title-row"
        data-index="{{index}}"
        bindtap="toggleTaskGroup"
        hover-class="row-hover"
      >
        <text class="group-arrow">{{item.expanded ? "▾" : "▸"}}</text>
        <text class="group-range">{{item.range}}{{item.expanded ? "" : "（折叠）"}}</text>
      </view>
      <view wx:if="{{item.expanded}}" class="task-items">
        <view wx:for="{{item.tasks}}" wx:key="name" class="task-item-row">
          <text class="task-item-name">{{item.name}}</text>
          <text class="task-item-tag">{{item.tag}}</text>
        </view>
      </view>
    </view>
  </view>
  </view>

  <view class="presence-quote-block">
    <text class="presence-plain">时间不是钟表，而是你真正沉浸在此刻的厚度。</text>
    <text class="presence-classic">感知有一个流动的原初自身亲临的点，除此之外还有一个刚才曾是（原滞留）的视域，以及一个即将来临（原前摄）的视域。</text>
    <text class="presence-attrib">—— 胡塞尔</text>
  </view>
</view>
