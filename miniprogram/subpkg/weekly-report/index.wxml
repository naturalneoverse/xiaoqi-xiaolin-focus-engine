<view class="page" style="{{_globalSafeAreaStyle}}">
  <view class="range-wrap">
    <text class="range-text">{{rangeLabel}}</text>
  </view>

  <view class="card">
    <text class="section-title">时间流向看得清</text>
    <text class="section-desc">这一周，你记下了 {{recordedCount}} 件事，做完了 {{finishedCount}} 件。</text>

    <view class="progress-list">
      <view class="progress-item" wx:for="{{distPriority}}" wx:key="key">
        <view class="progress-row"><text>{{item.key}}</text><text>{{item.percent}}%</text></view>
        <view class="bar"><view class="fill" style="width: {{item.percent}}%;"></view></view>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">意义质地能看见</text>
    <view class="dual-grid">
      <view class="col">
        <text class="col-title">为谁而做</text>
        <view class="mini-item" wx:for="{{distWhom}}" wx:key="key">
          <view class="mini-bar"><view class="mini-fill" style="width: {{item.percent}}%;"></view></view>
          <text class="mini-label">{{item.key}} ({{item.percent}}%)</text>
        </view>
      </view>

      <view class="col">
        <text class="col-title">为何而做</text>
        <view class="mini-item" wx:for="{{distWhy}}" wx:key="key">
          <view class="mini-bar"><view class="mini-fill" style="width: {{item.percent}}%;"></view></view>
          <text class="mini-label">{{item.key}} ({{item.percent}}%)</text>
        </view>
      </view>
    </view>

    <view class="moment-wrap">
      <text class="moment-text">真我时刻：{{momentScore}} 次</text>
    </view>
  </view>

  <view class="mascot-bottom-wrap">
    <view class="mascot-bubble-wrap">
      <chat-bubble
        text="{{mascotText}}"
        color="#b7d6ea"
        arrowPosition="right"
        maxLength="{{200}}"
      />
    </view>
    <view class="mascot-image-wrap">
      <image class="mascot-image" src="/images/transparent background/xiaolin.png" mode="aspectFit" binderror="onImageError" />
    </view>
  </view>

  <view class="actions">
    <button class="action-btn action-btn-primary" bindtap="goPoster">生成真我时刻海报</button>
    <button class="action-btn action-btn-ghost" bindtap="onShareToFriend">分享给朋友</button>
  </view>
</view>
