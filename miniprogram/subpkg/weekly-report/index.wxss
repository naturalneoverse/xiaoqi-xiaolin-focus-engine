page {
  background: #e2effc;
}

.page {
  min-height: 100vh;
  /* 竖向留白由 _globalSafeAreaStyle 与安全区负责，避免与内联 padding 叠出过大顶距 */
  padding-left: 22rpx;
  padding-right: 22rpx;
  box-sizing: border-box;
}

.range-wrap {
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 26rpx;
}

.range-text {
  color: rgba(18, 89, 143, 0.72);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
  letter-spacing: 1rpx;
}

.card {
  background: rgba(255, 255, 255, 0.93);
  border-radius: 28rpx;
  padding: 30rpx 26rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 20rpx 50rpx rgba(212, 233, 255, 0.32);
}

.section-title {
  display: block;
  color: #184061;
  font-size: 32rpx;
  font-weight: 700;
}

.section-desc {
  display: block;
  margin-top: 18rpx;
  color: #577388;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.progress-list {
  margin-top: 30rpx;
}

.progress-item {
  margin-bottom: 18rpx;
}

.progress-row {
  margin-bottom: 6rpx;
  display: flex;
  justify-content: space-between;
  color: #577388;
  font-size: 20rpx;
  opacity: 0.72;
  font-weight: 700;
}

.bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: #e1e5ea;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12598f;
}

.hint-wrap {
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(18, 89, 143, 0.1);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.hint-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  border: 2rpx dashed rgba(18, 89, 143, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(18, 89, 143, 0.5);
  font-size: 20rpx;
  flex-shrink: 0;
}

.hint-text {
  color: #577388;
  font-size: 24rpx;
  line-height: 1.65;
  font-style: italic;
}

.dual-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 28rpx;
}

.col-title {
  display: block;
  color: rgba(18, 89, 143, 0.42);
  font-size: 18rpx;
  font-weight: 700;
}

.mini-item {
  margin-top: 12rpx;
}

.mini-bar {
  height: 6rpx;
  border-radius: 999rpx;
  background: #e1e5ea;
  overflow: hidden;
}

.mini-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12598f;
}

.mini-label {
  display: block;
  margin-top: 5rpx;
  color: #577388;
  font-size: 19rpx;
}

.moment-wrap {
  margin-top: 28rpx;
  margin-bottom: 10rpx;
  text-align: center;
}

.moment-text {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(18, 89, 143, 0.05);
  color: #12598f;
  font-size: 31rpx;
  font-weight: 700;
}

.moment-footnote {
  display: block;
  margin-top: 14rpx;
  padding: 0 16rpx;
  color: #6a8499;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 400;
}

.summary-card {
  border-radius: 24rpx;
  background: #edf6fd;
  border: 1rpx solid rgba(18, 89, 143, 0.06);
  padding: 42rpx 34rpx;
  text-align: center;
}

.summary-text {
  color: #12598f;
  font-size: 33rpx;
  line-height: 1.8;
}

.mascot-bottom-wrap {
  margin-top: 10rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 6rpx 10rpx;
}

.mascot-bubble-wrap {
  flex: 1;
  min-width: 0;
  margin-bottom: 34rpx;
}

.mascot-bubble-wrap chat-bubble {
  display: block;
  width: 100%;
  max-width: none;
}

.mascot-bubble {
  position: relative;
  flex: 1;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 56% 44% 52% 48% / 46% 58% 42% 54%;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 34rpx;
}

.mascot-bubble::before {
  content: "";
  position: absolute;
  right: 16rpx;
  bottom: -20rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 20rpx solid #e5e7eb;
  transform: rotate(-18deg);
}

.mascot-bubble::after {
  content: "";
  position: absolute;
  right: 17rpx;
  bottom: -18rpx;
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 13rpx solid transparent;
  border-top: 18rpx solid #ffffff;
  transform: rotate(-18deg);
}

.mascot-bubble-text {
  display: block;
  text-align: center;
  color: #184061;
  font-size: 32rpx;
  line-height: 1.55;
}

.mascot-image-wrap {
  width: 170rpx;
  height: 220rpx;
  flex-shrink: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transform: translateY(14rpx);
}

.mascot-image-wrap .mascot-float-3d {
  width: 160rpx;
  height: 210rpx;
}

.actions {
  margin-top: 24rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  max-width: 100%;
  min-width: 520rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  height: 94rpx;
  border-radius: 47rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn-primary {
  background: #12598f;
  color: #ffffff;
  border: 2rpx solid #12598f;
}

.action-btn-ghost {
  background: #ffffff;
  color: #12598f;
  border: 2rpx solid #12598f;
}

.row-hover {
  opacity: 0.86;
}

/* 分享卡片画布：固定移出视口，避免影响点击与布局 */
.weekly-share-card-canvas {
  position: fixed;
  width: 1px;
  height: 1px;
  left: -2000px;
  top: 0;
  overflow: hidden;
  pointer-events: none;
}
